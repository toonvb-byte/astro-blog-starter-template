{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Worker name must match the Worker connected to this repo in the Cloudflare dashboard.
	// To rename: rename the Worker in the dashboard first, then change this value.
	"name": "astro-blog-starter-template",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Custom domains: Cloudflare creates the DNS records + HTTPS certificate on deploy.
	// Requires the nutrimetrics.eu zone to be active in this Cloudflare account.
	"routes": [
		{ "pattern": "nutrimetrics.eu", "custom_domain": true },
		{ "pattern": "www.nutrimetrics.eu", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nutrimetrics-db",
			"database_id": "db505c78-d80a-489c-9e75-c512141a7e95",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "f3007eacfc254ca2a71c8ea768895250"
		}
	]
	// Launch switch (noindex + robots.txt) lives in src/lib/site.ts → SITE_LIVE.
	// Secrets (set in dashboard → Worker → Settings → Variables, type "Secret"):
	//   AWIN_PUBLISHER_ID
}
