---
/**
 * Every non-home page, with localised slugs (see ROUTES in i18n/config.ts):
 *   /{locale}/{guides}/            → guides index
 *   /{locale}/{guides}/{slug}/     → article
 *   /{locale}/{about}/             → about & methodology
 *   /{locale}/{finder}/            → supplement goal finder
 *   /{locale}/{supplements}/       → supplements A–Z (hub index)
 *   /{locale}/{supplements}/{slug}/ → supplement hub (one ingredient or goal)
 *   /{locale}/{glossary}/          → glossary of ingredients, forms and label terms
 *   /{locale}/{news}/              → news index (country filter)
 *   /{locale}/{news}/{slug}/       → news item
 *   /es/mejores/ · /de/vergleich/  → rankings index (only locales with rankings)
 *   /es/mejores/{slug}/ · /de/vergleich/{slug}/ → ranking
 *   /{locale}/{prices|compare}/    → coming soon (build steps 3–5)
 *   /{locale}/legal/…              → legal pages
 */
import type { GetStaticPaths } from "astro";
import { LOCALES, ROUTES, type Locale, type RouteKey } from "../../i18n/config";
import { getGuides, guideLocale, guideSlug, type Guide } from "../../lib/guides";
import { getHubs, hubLocale, hubSlug, type Hub } from "../../lib/hubs";
import GuidesIndex from "../../views/GuidesIndex.astro";
import Article from "../../views/Article.astro";
import About from "../../views/About.astro";
import ComingSoon from "../../views/ComingSoon.astro";
import Legal from "../../views/Legal.astro";
import Finder from "../../views/Finder.astro";
import HubsIndex from "../../views/HubsIndex.astro";
import HubView from "../../views/Hub.astro";
import Glossary from "../../views/Glossary.astro";
import RankingView from "../../views/Ranking.astro";
import RankingsIndex from "../../views/RankingsIndex.astro";
import { getRankings, rankingLocale, rankingSlug, type Ranking } from "../../lib/rankings";
import { RANKING_BASE } from "../../i18n/config";
import { getNews, newsLocale, newsSlug, type NewsItem } from "../../lib/news";
import NewsIndex from "../../views/NewsIndex.astro";
import NewsItemView from "../../views/NewsItem.astro";

type Props =
	| { kind: RouteKey | "rankings"; guide?: undefined; hub?: undefined; ranking?: undefined; item?: undefined }
	| { kind: "article"; guide: Guide; hub?: undefined; ranking?: undefined; item?: undefined }
	| { kind: "hub"; hub: Hub; guide?: undefined; ranking?: undefined; item?: undefined }
	| { kind: "ranking"; ranking: Ranking; guide?: undefined; hub?: undefined; item?: undefined }
	| { kind: "newsItem"; item: NewsItem; guide?: undefined; hub?: undefined; ranking?: undefined };

export const getStaticPaths = (async () => {
	const pages = LOCALES.flatMap((locale) =>
		(Object.keys(ROUTES) as RouteKey[]).map((kind) => ({
			params: { locale, slug: ROUTES[kind][locale] },
			props: { kind },
		})),
	);
	const guides = await getGuides();
	const articles = guides.map((guide) => ({
		params: { locale: guideLocale(guide), slug: `${ROUTES.guides[guideLocale(guide)]}/${guideSlug(guide)}` },
		props: { kind: "article" as const, guide },
	}));
	const hubs = (await getHubs()).map((hub) => ({
		params: { locale: hubLocale(hub), slug: `${ROUTES.supplements[hubLocale(hub)]}/${hubSlug(hub)}` },
		props: { kind: "hub" as const, hub },
	}));
	// /es/mejores/{slug}/ · /de/vergleich/{slug}/ — rankings exist only in their market's language.
	const rankings = (await getRankings()).map((ranking) => ({
		params: { locale: rankingLocale(ranking), slug: `${RANKING_BASE[rankingLocale(ranking)]}/${rankingSlug(ranking)}` },
		props: { kind: "ranking" as const, ranking },
	}));
	const rankingIndexes = LOCALES.filter((l) => RANKING_BASE[l]).map((locale) => ({
		params: { locale, slug: RANKING_BASE[locale]! },
		props: { kind: "rankings" as const },
	}));
	const news = (await getNews()).map((item) => ({
		params: { locale: newsLocale(item), slug: `${ROUTES.news[newsLocale(item)]}/${newsSlug(item)}` },
		props: { kind: "newsItem" as const, item },
	}));
	return [...pages, ...articles, ...hubs, ...rankingIndexes, ...rankings, ...news];
}) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const { kind, guide, hub, ranking, item } = Astro.props as Props;
---
{kind === "guides" && <GuidesIndex locale={locale} />}
{kind === "article" && guide && <Article locale={locale} guide={guide} />}
{kind === "about" && <About locale={locale} />}
{kind === "finder" && <Finder locale={locale} />}
{kind === "supplements" && <HubsIndex locale={locale} />}
{kind === "hub" && hub && <HubView locale={locale} hub={hub} />}
{kind === "rankings" && <RankingsIndex locale={locale} />}
{kind === "ranking" && ranking && <RankingView locale={locale} ranking={ranking} />}
{kind === "glossary" && <Glossary locale={locale} />}
{kind === "news" && <NewsIndex locale={locale} />}
{kind === "newsItem" && item && <NewsItemView locale={locale} item={item} />}
{(kind === "prices" || kind === "compare") && <ComingSoon locale={locale} which={kind} />}
{(kind === "privacy" || kind === "cookies" || kind === "imprint" || kind === "disclosure") && <Legal locale={locale} which={kind} />}
