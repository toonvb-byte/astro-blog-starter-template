---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { LOCALES, path, routeAlternates, type Locale } from "../../i18n/config";
import { useT } from "../../i18n/ui";
import { getGuides, guideUrl } from "../../lib/guides";
import { getHubs, hubUrl } from "../../lib/hubs";

export function getStaticPaths() {
	return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useT(locale);
const about = path(locale, "about");
const guides = path(locale, "guides");
const finder = path(locale, "finder");

const all = await getGuides(locale);
// Hand-picked cornerstone guides (by translationKey), shown if they exist in this language.
const PICKS = ["magnesium-forms", "creatine-guide", "vitamin-d-winter", "omega3-sources"];
const picks = PICKS.map((k) => all.find((g) => g.data.translationKey === k)).filter((g) => g !== undefined);
const posts = all.filter((g) => !picks.includes(g)).slice(0, 3);
const chipLink = (c: string) => `${guides}?q=${encodeURIComponent(c)}`;
const hubs = await getHubs(locale);
---
<Base locale={locale} title={t("home.title")} description={t("home.description")} alternates={routeAlternates()} active="home">
	<section aria-labelledby="hero-h" style="background:var(--nm-surface);border-bottom:1px solid var(--nm-line)">
		<div class="container hero">
			<div class="hero-copy">
				<span class="eyebrow">{t("home.eyebrow")}</span>
				<h1 id="hero-h" class="h1">{t("home.h1")}</h1>
				<p class="lead" style="max-width:600px">{t("home.lead")}</p>
				<form role="search" action={guides} method="get" class="hero-search">
					<label for="hero-q" class="sr-only">{t("home.searchLabel")}</label>
					<input id="hero-q" name="q" type="search" placeholder={t("home.searchPlaceholder")} class="hero-q" />
					<button type="submit" class="btn btn-primary btn-lg">{t("home.cta")}</button>
				</form>
				<div class="chips">
					<span class="muted" style="font-size:14px;margin-right:4px">{t("home.popular")}</span>
					{t("chips").map((c) => <a href={chipLink(c)} class="chip">{c}</a>)}
				</div>
			</div>
			<aside aria-labelledby="finder-h" class="snapshot">
				<span class="eyebrow" style="font-size:12px">{t("nav.finder")}</span>
				<h2 id="finder-h" style="font-family:var(--nm-font-display);font-weight:600;font-size:22px;line-height:1.25;margin:0">{t("home.finderH")}</h2>
				<p style="color:var(--nm-ink-2);margin:0">{t("home.finderP")}</p>
				<ul class="finder-goals">
					{t("home.finderGoals").map((g) => <li>{g}</li>)}
				</ul>
				<a href={finder} class="btn btn-primary" style="align-self:flex-start">{t("home.finderCta")}</a>
			</aside>
		</div>
	</section>

	<section aria-label={t("home.trustLabel")} style="border-bottom:1px solid var(--nm-line)">
		<div class="container trust">
			{[t("home.trust1"), t("home.trust2"), t("home.trust3"), t("home.trust4")].map((s) => (
				<div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B6B4F" stroke-width="2" aria-hidden="true"><path d="M4 12l5 5L20 6"></path></svg>{s}</div>
			))}
		</div>
	</section>

	<section aria-labelledby="how-h" class="container section" style="padding-top:72px">
		<h2 id="how-h" class="h2">{t("home.howH")}</h2>
		<ol class="grid-auto how" style="--min:260px">
			{[["home.how1h", "home.how1p"], ["home.how2h", "home.how2p"], ["home.how3h", "home.how3p"]].map(([h, p], i) => (
				<li class="card">
					<span class="mono" style="font-weight:600;color:var(--nm-accent)">0{i + 1}</span>
					<h3 class="h3">{t(h as "home.how1h")}</h3>
					<p style="color:var(--nm-ink-2)">{t(p as "home.how1p")}</p>
				</li>
			))}
		</ol>
	</section>

	{hubs.length > 0 && (
		<section aria-labelledby="cat-h" class="container section">
			<div class="section-head">
				<h2 id="cat-h" class="h2">{t("home.catH")}</h2>
				<a href={path(locale, "supplements")} class="link-strong">{t("hub.all")} →</a>
			</div>
			<ul class="hub-chips">
				{hubs.map((h) => <li><a href={hubUrl(h)} class={`chip${h.data.kind === "goal" ? " chip-goal" : ""}`}>{h.data.name}</a></li>)}
			</ul>
		</section>
	)}

	{picks.length > 0 && (
		<section aria-labelledby="cmp-h" class="container section">
			<div class="section-head">
				<h2 id="cmp-h" class="h2">{t("home.cmpH")}</h2>
				<a href={guides} class="link-strong">{t("home.blogAll")}</a>
			</div>
			<div class="grid-auto">
				{picks.map((g) => (
					<a href={guideUrl(g)} class="card cmp-card">
						<span style="font-size:13px;font-weight:600;color:var(--nm-accent)">{g.data.category}</span>
						<span style="font-family:var(--nm-font-display);font-weight:600;font-size:21px;line-height:1.2">{g.data.title}</span>
						<span class="muted" style="font-size:14px">{g.data.description}</span>
						<span class="muted cmp-foot">{g.data.readingMinutes} {t("guides.read")}</span>
					</a>
				))}
			</div>
		</section>
	)}

	{posts.length > 0 && (
		<section aria-labelledby="blog-h" class="container section">
			<div class="section-head">
				<h2 id="blog-h" class="h2">{t("home.blogH")}</h2>
				<a href={guides} class="link-strong">{t("home.blogAll")}</a>
			</div>
			<div class="grid-auto" style="--min:300px;gap:24px">
				{posts.map((p) => (
					<ArticleCard
						href={guideUrl(p)}
						category={p.data.category}
						title={p.data.title}
						meta={`${p.data.readingMinutes} ${t("guides.read")}${p.data.reviewer ? ` · ${t("guides.reviewedBy")} ${p.data.reviewer}` : ""}`}
						tint={p.data.tint}
						image={p.data.heroImage}
					/>
				))}
			</div>
		</section>
	)}

	<section aria-labelledby="trust-h" class="container" style="padding-top:72px;padding-bottom:24px">
		<div class="dark-panel">
			<div style="flex:1 1 360px;min-width:0;display:flex;flex-direction:column;gap:16px">
				<h2 id="trust-h" class="h2">{t("home.moneyH")}</h2>
				<p>{t("home.moneyP")}</p>
				<a href={`${about}#method`} class="btn btn-light" style="align-self:flex-start">{t("home.moneyCta")}</a>
			</div>
			<ul>
				<li><strong>{t("home.p1s")}</strong> <span>{t("home.p1")}</span></li>
				<li><strong>{t("home.p2s")}</strong> <span>{t("home.p2")}</span></li>
				<li><strong>{t("home.p3s")}</strong> <span>{t("home.p3")}</span></li>
			</ul>
		</div>
	</section>

</Base>

<style>
	.hero { padding-top: 72px; padding-bottom: 64px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
	.hero-copy { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
	.hero-search { display: flex; flex-wrap: wrap; gap: 10px; margin: 8px 0 0; padding: 10px; background: #fff; border: 1px solid var(--nm-input-line); border-radius: 14px; max-width: 680px; }
	.hero-q { flex: 1 1 260px; min-width: 0; height: 52px; padding: 0 16px; border: 0; font: inherit; font-size: 17px; color: var(--nm-ink); background: transparent; }
	.chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
	.snapshot { flex: 1 1 360px; min-width: 0; background: var(--nm-ground); border: 1px solid var(--nm-line); border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 14px; }
	.finder-goals { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
	.finder-goals li { background: #fff; border: 1px solid var(--nm-line); border-radius: var(--nm-pill); padding: 6px 12px; font-size: 14px; }
	.trust { padding-top: 22px; padding-bottom: 22px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; font-size: 15px; color: var(--nm-ink-2); }
	.trust div { display: flex; align-items: center; gap: 10px; }
	.how { list-style: none; margin: 0; padding: 0; }
	.hub-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
	.chip-goal { background: var(--nm-accent-soft); border-color: transparent; font-weight: 600; color: var(--nm-accent-ink); }
	.how li { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
	.cmp-card { display: flex; flex-direction: column; gap: 14px; padding: 22px; text-decoration: none; color: var(--nm-ink); }
	.cmp-card:hover { border-color: var(--nm-accent); color: var(--nm-ink); }
	.cmp-foot { margin-top: auto; font-size: 13px; border-top: 1px solid var(--nm-line-soft); padding-top: 12px; }
	@media (max-width: 600px) { .hero { padding-top: 40px; padding-bottom: 40px; } }
</style>
