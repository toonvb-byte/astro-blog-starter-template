---
/**
 * Spanish-only product landing page for EnergyProDetox (Nutrición Científica Barcelona).
 * Used as the Google Ads (Search) landing page: it has to carry original analysis, not just a link
 * (Google Ads "Insufficient original content" policy rejects pure bridge pages).
 *
 * Shop links go through /go/{OFFER_ID} (D1: offers.id 1 → retailers.id 1 NCB, product 9001).
 * The merchant URL with the ENERGIA10 code lives in D1, so it can change without a redeploy.
 * Label data: manufacturer product page, checked 21 Oct 2026. Only EU-authorised claims (Reg. 432/2012).
 */
import Base from "../../../layouts/Base.astro";
import AffiliateLink from "../../../components/AffiliateLink.astro";
import { path } from "../../../i18n/config";
import { SITE_URL } from "../../../lib/site";

const OFFER_ID = 1;
const CODE = "ENERGIA10";
const PRICE = 79.9;
const SACHETS = 22;
const CHECKED = "2026-10-21";
const CHECKED_LABEL = "21 oct 2026";
const SOURCE = "https://nutricioncientificabarcelona.com/products/energy-pro-detox";
const URL_PATH = "/es/productos/energyprodetox/";
const AUTHOR = "Toon Van Buylaere";

const eur = (n: number) => new Intl.NumberFormat("es-ES", { style: "currency", currency: "EUR" }).format(n);
const perDay = eur(PRICE / SACHETS);

type Claim = "si" | "no" | "espera" | "poco";
interface Row { name: string; form?: string; amount: string; nrv?: string; claim: Claim; note?: string }
interface Group { id: string; h: string; intro?: string; nrv: boolean; rows: Row[]; foot?: string }

const groups: Group[] = [
	{
		id: "vitaminas",
		h: "Vitaminas",
		nrv: true,
		rows: [
			{ name: "Vitamina C", form: "ácido ascórbico", amount: "350 mg", nrv: "438 %", claim: "si" },
			{ name: "Vitamina B1", form: "tiamina", amount: "5 mg", nrv: "455 %", claim: "si" },
			{ name: "Vitamina B2", form: "riboflavina", amount: "7 mg", nrv: "500 %", claim: "si" },
			{ name: "Niacina (B3)", form: "nicotinamida", amount: "100 mg", nrv: "625 %", claim: "si" },
			{ name: "Ácido pantoténico (B5)", form: "D-pantotenato cálcico", amount: "30 mg", nrv: "500 %", claim: "si" },
			{ name: "Vitamina B6", form: "piridoxina", amount: "7 mg", nrv: "500 %", claim: "si" },
			{ name: "Biotina (B7)", amount: "250 µg", nrv: "500 %", claim: "si" },
			{ name: "Folato (B9)", form: "metilfolato cálcico", amount: "1.000 µg", nrv: "500 %", claim: "si", note: "Igual al máximo tolerable de la EFSA para adultos" },
			{ name: "Vitamina B12", form: "metilcobalamina", amount: "12,5 µg", nrv: "500 %", claim: "si" },
		],
	},
	{
		id: "minerales",
		h: "Minerales",
		nrv: true,
		rows: [
			{ name: "Magnesio", form: "bisglicinato 350 mg + citrato 125 mg", amount: "≈70 mg*", nrv: "≈19 %*", claim: "si" },
			{ name: "Zinc", form: "citrato 10 mg", amount: "≈3,2 mg*", nrv: "≈32 %*", claim: "si" },
			{ name: "Selenio", form: "selenito sódico 80 µg", amount: "≈37 µg*", nrv: "≈66 %*", claim: "si" },
			{ name: "Molibdeno", form: "molibdato sódico 100 µg", amount: "≈40 µg*", nrv: "≈79 %*", claim: "si" },
			{ name: "Manganeso", form: "gluconato 3 mg", amount: "≈0,35 mg*", nrv: "≈17 %*", claim: "si" },
			{ name: "Cobre", form: "gluconato 1 mg", amount: "≈0,14 mg*", nrv: "≈14 %*", claim: "poco" },
		],
		foot: "* La ficha del fabricante da el peso de la sal mineral (por ejemplo, 350 mg de bisglicinato de magnesio). El mineral puro, que es lo que cuenta para el %VRN, es menor. Lo estimamos con la proporción de mineral de cada sal; si el fabricante se refiere al mineral puro, las cifras serían más altas.",
	},
	{
		id: "aminoacidos",
		h: "Aminoácidos y compuestos afines",
		intro: "Casi 5 g por sobre. Es la parte más grande de la fórmula y la que lo diferencia de un multivitamínico.",
		nrv: false,
		rows: [
			{ name: "Taurina", amount: "1.500 mg", claim: "no" },
			{ name: "Acetil-L-carnitina", amount: "1.500 mg", claim: "no" },
			{ name: "L-glutamina", amount: "1.000 mg", claim: "no" },
			{ name: "N-acetilcisteína (NAC)", amount: "250 mg", claim: "no" },
			{ name: "Glicina", amount: "250 mg", claim: "no" },
			{ name: "Betaína", form: "trimetilglicina", amount: "250 mg", claim: "no", note: "La declaración sobre la homocisteína exige 1,5 g al día" },
			{ name: "Glucuronolactona", amount: "100 mg", claim: "no" },
			{ name: "Ácido R-lipoico", amount: "30 mg", claim: "no" },
			{ name: "NADH", amount: "5 mg", claim: "no" },
		],
	},
	{
		id: "plantas",
		h: "Extractos vegetales y otros",
		nrv: false,
		rows: [
			{ name: "Trans-resveratrol", form: "raíz de Polygonum cuspidatum", amount: "250 mg", claim: "no" },
			{ name: "Chlorella", form: "Chlorella pyrenoidosa", amount: "200 mg", claim: "no" },
			{ name: "Lecitina de girasol", amount: "150 mg", claim: "no" },
			{ name: "Alcachofa", form: "extracto 10:1, 5 % cinarina", amount: "125 mg", claim: "espera" },
			{ name: "Cardo mariano", form: "extracto 25:1, 80 % silimarina", amount: "100 mg", claim: "espera" },
			{ name: "Bioflavonoides cítricos", amount: "100 mg", claim: "no" },
			{ name: "Lepidium latifolium", form: "extracto de raíz", amount: "50 mg", claim: "no" },
			{ name: "Diente de león", form: "extracto 11:1", amount: "25 mg", claim: "espera" },
		],
		foot: "También lleva isomaltulosa (palatinosa) como endulzante y aroma natural de naranja, sin cantidad indicada.",
	},
];

const claimLabel: Record<Claim, string> = {
	si: "Sí",
	no: "No",
	espera: "En espera en la UE",
	poco: "No (menos del 15 % del VRN)",
};

const benefits = [
	{
		h: "Energía y menos cansancio",
		items: [
			["contribuyen a disminuir el cansancio y la fatiga", "Vitamina C, B2, niacina, B5, B6, B12, folato y magnesio"],
			["contribuyen al metabolismo energético normal", "Vitamina C, B1, B2, niacina, B5, B6, B12, biotina, magnesio y manganeso"],
		],
	},
	{
		h: "Defensas",
		items: [["contribuyen al funcionamiento normal del sistema inmunitario", "Vitamina C, B6, B12, folato, zinc y selenio"]],
	},
	{
		h: "Mente y sistema nervioso",
		items: [
			["contribuyen a la función psicológica normal", "Vitamina C, B1, niacina, B6, B12, biotina, folato y magnesio"],
			["contribuyen al funcionamiento normal del sistema nervioso", "Vitamina C, B1, B2, niacina, B6, B12, biotina y magnesio"],
			["contribuyen al rendimiento intelectual y a la función cognitiva normales", "Ácido pantoténico (B5) y zinc"],
		],
	},
	{
		h: "Protección de las células",
		items: [["contribuyen a la protección de las células frente al daño oxidativo", "Vitamina C, B2, zinc, selenio y manganeso"]],
	},
	{
		h: "Piel, cabello y uñas",
		items: [
			["contribuyen al mantenimiento de la piel en condiciones normales", "Biotina, niacina, B2 y zinc"],
			["contribuyen al mantenimiento del cabello y de las uñas en condiciones normales", "Biotina (cabello), zinc y selenio"],
			["contribuye a la formación normal de colágeno para el funcionamiento normal de la piel", "Vitamina C"],
		],
	},
	{
		h: "Músculos y metabolismo",
		items: [
			["contribuye al funcionamiento normal de los músculos", "Magnesio"],
			["contribuyen al metabolismo normal de la homocisteína", "Vitamina B6, B12 y folato"],
			["contribuye al metabolismo normal de los aminoácidos azufrados", "Molibdeno"],
		],
	},
];

const faq = [
	{
		q: "¿Qué es EnergyProDetox?",
		a: "Un complemento alimenticio en polvo de Nutrición Científica Barcelona (NCB). Cada sobre de 10 g combina vitaminas del grupo B y C, minerales, unos 5 g de aminoácidos (taurina, acetil-L-carnitina, glutamina y otros) y extractos de plantas como cardo mariano, alcachofa y resveratrol.",
	},
	{
		q: "¿Cómo se toma?",
		a: "Según el fabricante, un sobre al día disuelto en un vaso grande de agua, en ayunas. Tiene sabor a naranja.",
	},
	{
		q: "¿Cuánto cuesta al día?",
		a: `La caja de ${SACHETS} sobres cuesta ${eur(PRICE)} en la tienda oficial (precio comprobado el ${CHECKED_LABEL}), unos ${perDay} al día. El código ${CODE} reduce el precio en la tienda oficial y también hay packs de 3 y 6 cajas.`,
	},
	{
		q: `¿Cómo uso el código ${CODE}?`,
		a: `Entra desde los botones de esta página: el enlace aplica el código ${CODE} automáticamente en la tienda de NCB. Si no lo ves en la cesta, escríbelo en el campo de código de descuento al pagar.`,
	},
	{
		q: "¿Puedo tomarlo si tomo medicación?",
		a: "Consúltalo antes con tu médico o farmacéutico. Lleva trans-resveratrol, y la normativa europea exige que los complementos con resveratrol indiquen que quien toma medicamentos debe tomarlos solo bajo supervisión médica.",
	},
	{
		q: "¿Sirve para desintoxicar el cuerpo?",
		a: "Ningún complemento alimenticio tiene en la UE una declaración autorizada para «desintoxicar» o eliminar toxinas o metales pesados; «Detox» forma parte del nombre comercial. Lo que sí está autorizado son los efectos de sus vitaminas y minerales, por ejemplo sobre el cansancio, el metabolismo energético y el sistema inmunitario.",
	},
	{
		q: "¿Es apto para niños?",
		a: "Nuestro análisis es para adultos. Con 1.000 µg de folato al día supera el nivel máximo tolerable que la EFSA fija para menores de 18 años, y la vitamina B6 supera el de los niños de hasta 10 años. Para un niño, consulta antes con su pediatra.",
	},
];

const sources = [
	{ title: "Nutrición Científica Barcelona — ficha de EnergyProDetox (composición y modo de empleo)", url: SOURCE },
	{ title: "Comisión Europea — Registro de declaraciones nutricionales y de propiedades saludables", url: "https://food.ec.europa.eu/food-safety/labelling-and-nutrition/nutrition-and-health-claims/eu-register-health-claims_en" },
	{ title: "Reglamento (UE) n.º 432/2012 — lista de declaraciones de propiedades saludables autorizadas", url: "https://eur-lex.europa.eu/eli/reg/2012/432/oj" },
	{ title: "Reglamento de Ejecución (UE) 2021/51 — condiciones de uso del trans-resveratrol como nuevo alimento", url: "https://eur-lex.europa.eu/eli/reg_impl/2021/51/oj" },
	{ title: "EFSA — Resumen de niveles máximos tolerables de ingesta (folato, vitamina B6 y otros)", url: "https://www.efsa.europa.eu/sites/default/files/2024-05/ul-summary-report.pdf" },
];

const title = "EnergyProDetox: ingredientes, dosis y código descuento";
const description = `Análisis de EnergyProDetox: sus más de 30 ingredientes con dosis, qué beneficios autoriza la UE, cuánto cuesta al día y cómo usar el código ${CODE}.`;
const abs = (p: string) => new URL(p, SITE_URL).href;

const jsonLd: object[] = [
	{
		"@context": "https://schema.org",
		"@type": "Article",
		headline: "EnergyProDetox: ingredientes, dosis y para quién es",
		description,
		inLanguage: "es",
		url: abs(URL_PATH),
		datePublished: `${CHECKED}T00:00:00.000Z`,
		dateModified: `${CHECKED}T00:00:00.000Z`,
		about: { "@type": "Product", name: "EnergyProDetox", brand: { "@type": "Brand", name: "Nutrición Científica Barcelona" } },
		author: { "@type": "Person", name: AUTHOR, url: abs(`${path("es", "about")}#team`) },
		publisher: { "@id": `${SITE_URL}/#org` },
		isPartOf: { "@id": `${SITE_URL}/#website` },
		citation: sources.map((s) => ({ "@type": "CreativeWork", name: s.title, url: s.url })),
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
	},
];

const toc = [
	{ slug: "resumen", text: "En resumen" },
	{ slug: "ingredientes", text: "Ingredientes y dosis" },
	{ slug: "beneficios", text: "Beneficios autorizados" },
	{ slug: "no-promete", text: "Lo que no puede prometer" },
	{ slug: "valoracion", text: "Nuestra valoración" },
	{ slug: "precauciones", text: "Precauciones" },
	{ slug: "precio", text: "Precio y código" },
	{ slug: "faq", text: "Preguntas frecuentes" },
	{ slug: "fuentes", text: "Fuentes" },
];
---
<Base
	locale="es"
	title={title}
	description={description}
	alternates={{ es: URL_PATH }}
	active="supplements"
	ogType="article"
	disclosure
	breadcrumbs={[
		{ name: "Inicio", href: path("es") },
		{ name: "Suplementos", href: path("es", "supplements") },
		{ name: "EnergyProDetox", href: URL_PATH },
	]}
	jsonLd={jsonLd}
>
	<div class="container">
		<nav aria-label="Breadcrumb" class="crumbs">
			<ol>
				<li><a href={path("es")}>Inicio</a></li>
				<li><a href={path("es", "supplements")}>Suplementos</a></li>
				<li aria-current="page">EnergyProDetox</li>
			</ol>
		</nav>

		<header class="hero">
			<div class="hero-text">
				<span class="eyebrow">Análisis de producto</span>
				<h1 class="h1">EnergyProDetox: ingredientes, dosis y para quién es</h1>
				<p class="lead">
					Un sobre al día con vitaminas B y C, minerales, aminoácidos y extractos de plantas. Aquí tienes cada
					ingrediente con su dosis, los beneficios que autoriza la UE y lo que cuesta al día.
				</p>

				<div class="coupon" aria-labelledby="coupon-h">
					<div class="coupon-top">
						<p id="coupon-h" class="coupon-label">Código de descuento en la tienda oficial</p>
						<div class="code-row">
							<span class="code mono" id="code">{CODE}</span>
							<button type="button" class="copy" data-copy={CODE} aria-describedby="code">Copiar</button>
							<span class="copied" role="status" aria-live="polite"></span>
						</div>
					</div>
					<AffiliateLink offerId={OFFER_ID} placement="epd:hero" class="btn-lg cta">
						Ver EnergyProDetox con el código {CODE} <span aria-hidden="true">→</span>
					</AffiliateLink>
					<p class="coupon-note">
						Te llevamos a nutricioncientificabarcelona.com y el código se aplica al entrar.
						Enlace de afiliado: si compras, NutriMetrics recibe una comisión sin coste para ti.
					</p>
				</div>
			</div>

			<aside class="pack" aria-label="Ficha rápida">
				<p class="pack-brand">Nutrición Científica Barcelona</p>
				<p class="pack-name">EnergyProDetox</p>
				<dl class="pack-facts">
					<div><dt>Dosis diaria</dt><dd>1 sobre de 10 g</dd></div>
					<div><dt>Sobres por caja</dt><dd class="mono">{SACHETS}</dd></div>
					<div><dt>Ingredientes con dosis</dt><dd>más de 30</dd></div>
					<div><dt>Formato</dt><dd>Polvo, sabor naranja</dd></div>
					<div><dt>Precio por caja</dt><dd class="mono">{eur(PRICE)}</dd></div>
					<div class="pack-hl"><dt>Coste por día</dt><dd class="mono">{perDay}</dd></div>
				</dl>
				<p class="pack-note">Sin gluten ni lactosa, según el fabricante. Precio sin descuento, comprobado el {CHECKED_LABEL}.</p>
			</aside>
		</header>

		<div class="byline">
			<span><span class="muted">Análisis de</span> <a href={`${path("es", "about")}#team`}>{AUTHOR}</a></span>
			<span><span class="muted">Composición comprobada</span> <time datetime={CHECKED}>{CHECKED_LABEL}</time></span>
		</div>

		<div class="layout">
			<aside aria-labelledby="toc-h" class="toc">
				<h2 id="toc-h">En esta página</h2>
				<ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
			</aside>

			<article class="prose">
				<section id="resumen" aria-labelledby="resumen-h" class="quick">
					<h2 id="resumen-h">En resumen</h2>
					<ul>
						<li><strong>Todo en un sobre:</strong> vitaminas B y C en dosis altas (de 4 a 6 veces el VRN), algo de magnesio y zinc, casi 5 g de taurina, acetil-L-carnitina, glutamina y otros aminoácidos, y extractos de cardo mariano, alcachofa y resveratrol.</li>
						<li><strong>Beneficios autorizados:</strong> sus vitaminas y minerales tienen declaraciones aprobadas por la UE sobre el cansancio, el metabolismo energético, las defensas y el sistema nervioso.</li>
						<li><strong>Etiqueta transparente:</strong> indica la cantidad de cada ingrediente, sin «mezclas exclusivas», y usa formas bien absorbidas como metilcobalamina, metilfolato y bisglicinato de magnesio.</li>
						<li><strong>Precio:</strong> {eur(PRICE)} la caja de {SACHETS} sobres, unos {perDay} al día antes del descuento del código {CODE}.</li>
						<li><strong>Para adultos.</strong> Consulta antes si tomas medicación, estás embarazada o das el pecho, o ya tomas otro suplemento con ácido fólico.</li>
					</ul>
				</section>

				<section id="ingredientes" aria-labelledby="ing-h">
					<h2 id="ing-h">Ingredientes y dosis por sobre</h2>
					<p>
						Esta es la composición por dosis diaria (un sobre de 10 g) que publica el fabricante. Para las vitaminas
						y los minerales añadimos el %VRN, el porcentaje del valor de referencia de nutrientes de la UE. La última
						columna indica si la UE ha autorizado alguna declaración de salud para ese ingrediente.
					</p>
					{groups.map((g) => (
						<div class="group" id={g.id}>
							<h3>{g.h}</h3>
							{g.intro && <p class="group-intro">{g.intro}</p>}
							<div class="table-wrap">
								<table class="table stack ing">
									<thead>
										<tr>
											<th scope="col">Ingrediente</th>
											<th scope="col">Por sobre</th>
											{g.nrv && <th scope="col">%VRN</th>}
											<th scope="col">Declaración UE</th>
										</tr>
									</thead>
									<tbody>
										{g.rows.map((r) => (
											<tr>
												<th scope="row">{r.name}{r.form && <span class="form">{r.form}</span>}</th>
												<td data-label="Por sobre" class="mono">{r.amount}</td>
												{g.nrv && <td data-label="%VRN" class="mono">{r.nrv}</td>}
												<td data-label="Declaración UE">
													<span class={`claim claim-${r.claim}`}>{claimLabel[r.claim]}</span>
													{r.note && <span class="row-note">{r.note}</span>}
												</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
							{g.foot && <p class="foot">{g.foot}</p>}
						</div>
					))}
					<p class="foot">
						«En espera en la UE»: la Comisión Europea todavía no ha evaluado las declaraciones de las plantas, así que
						hoy no hay ninguna autorizada. Fuente de la composición: <a href={SOURCE} rel="noopener nofollow" target="_blank">ficha del fabricante</a>, consultada el {CHECKED_LABEL}.
					</p>
				</section>

				<aside class="mid-cta" aria-label="Comprar con descuento">
					<p><strong>¿Te encaja la fórmula?</strong> Con el código <span class="mono">{CODE}</span> lo tienes con descuento en la tienda oficial.</p>
					<AffiliateLink offerId={OFFER_ID} placement="epd:ingredientes">Ir a la tienda con {CODE} <span aria-hidden="true">→</span></AffiliateLink>
				</aside>

				<section id="beneficios" aria-labelledby="ben-h">
					<h2 id="ben-h">Beneficios autorizados en la UE</h2>
					<p>
						Estas son las declaraciones que el Reglamento (UE) 432/2012 permite para las vitaminas y minerales que
						EnergyProDetox aporta en cantidad significativa (al menos el 15 % del VRN por sobre). Son las únicas que
						cualquier marca puede usar legalmente para hablar de lo que hace un complemento.
					</p>
					<div class="benefits">
						{benefits.map((b) => (
							<div class="benefit">
								<h3>{b.h}</h3>
								<ul>
									{b.items.map(([claim, who]) => (
										<li><strong>{who}</strong> {claim}.</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</section>

				<section id="no-promete" aria-labelledby="np-h">
					<h2 id="np-h">Lo que no puede prometer</h2>
					<p>
						La mayor parte de la fórmula en gramos (taurina, acetil-L-carnitina, glutamina, NAC, resveratrol,
						chlorella, ácido R-lipoico, NADH) no tiene ninguna declaración de salud autorizada en la UE. Eso no
						significa que no hagan nada, sino que nadie puede atribuirles legalmente un efecto concreto en un complemento.
					</p>
					<p>
						Lo mismo vale para la palabra «detox». Ningún complemento alimenticio tiene en la UE una declaración
						autorizada para desintoxicar, depurar o eliminar toxinas o metales pesados: el hígado y los riñones
						ya hacen ese trabajo. En EnergyProDetox, «Detox» es parte del nombre comercial.
					</p>
				</section>

				<section id="valoracion" aria-labelledby="val-h">
					<h2 id="val-h">Nuestra valoración</h2>
					<div class="verdict">
						<div class="v-box yes">
							<h3>A favor</h3>
							<ul>
								<li>Sustituye varios botes: complejo B, vitamina C, minerales y aminoácidos en una sola toma.</li>
								<li>Etiqueta transparente, con la cantidad de cada ingrediente.</li>
								<li>Formas bien elegidas: metilcobalamina (B12), metilfolato (B9), bisglicinato y citrato de magnesio, citrato de zinc.</li>
