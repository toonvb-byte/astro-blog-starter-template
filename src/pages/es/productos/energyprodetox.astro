<script>
	// Copy-code button.
	document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((btn) => {
		btn.addEventListener("click", async () => {
			const status = btn.parentElement?.querySelector(".copied");
			try {
				await navigator.clipboard.writeText(btn.dataset.copy ?? "");
				if (status) status.textContent = "Copiado";
			} catch {
				if (status) status.textContent = "Selecciona y copia el código";
			}
			setTimeout(() => { if (status) status.textContent = ""; }, 2500);
		});
	});

	// Shop clicks go through our own /go/ redirect, so GA doesn't see them as outbound.
	// Send an event when GA has been loaded (only after cookie consent). Mark it as a key event in GA4 to import into Google Ads.
	document.querySelectorAll<HTMLAnchorElement>('a[href^="/go/"]').forEach((a) => {
		a.addEventListener("click", () => {
			const w = window as unknown as { gtag?: (...args: unknown[]) => void };
			const placement = new URL(a.href).searchParams.get("p") ?? "";
			w.gtag?.("event", "affiliate_click", { merchant: "ncb", product: "energyprodetox", placement });
		});
	});
</script>

