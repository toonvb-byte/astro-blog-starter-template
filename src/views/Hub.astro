---
/**
 * Supplement hub (category page) for one ingredient or one goal.
 * Content: src/content/hubs/{locale}/{slug}.mdx. Products and goal evidence: scripts/seed/finder-data.json.
 * No prices, ratings or images from third parties are shown here (see claude/page-architecture.md).
 */
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { LOCALES, path, type Locale } from "../i18n/config";
import { useT, formatDate } from "../i18n/ui";
import { getGuides, guideUrl, inlineMd } from "../lib/guides";
import {
	getHubs, hubAlternates, hubUrl, productsFor, goalRows, ingredient, amount, evidenceLabel, checkedDate, type Hub,
} from "../lib/hubs";
import { SITE_URL } from "../lib/site";
import { FINDER_TO_GLOSSARY, glossaryUrl } from "../lib/glossary";
import { schemaImages, socialImage } from "../lib/images";
import HeroImage from "../components/HeroImage.astro";
import { rankingsForHub, rankingUrl } from "../lib/rankings";

interface Props { locale: Locale; hub: Hub }
const { locale, hub } = Astro.props;
const d = hub.data;
const t = useT(locale);
const { Content, headings } = await render(hub);
const alternates = await hubAlternates(hub);
const url = hubUrl(hub);
const updated = d.updatedDate ?? d.publishDate;
const hubsHere = await getHubs(locale);

// Goal hubs show the finder's evidence map; their product table covers every ingredient of the goal.
const rows = d.finderGoal ? goalRows(d.finderGoal) : [];
const ingIds = d.finderGoal ? rows.map((r) => r.i) : d.finderIngredients;
const products = productsFor(ingIds, d.finderGoal ? undefined : d.hubKey);
// Nutrients shown per product: the hub's own ingredients plus any extras listed in finderShow.
const showIds = [...ingIds, ...d.finderShow.filter((i) => !ingIds.includes(i))];
const hubForIngredient = (id: string) => hubsHere.find((h) => h.data.kind === "ingredient" && h.data.finderIngredients.includes(id));

const rankingsHere = d.kind === "ingredient" ? await rankingsForHub(d.hubKey, locale) : [];
const rankingCta = { en: "Ranked by label analysis", es: "Ranking por análisis de etiqueta", de: "Vergleich nach Etikett-Analyse" }[locale];
const guidesHere = await getGuides(locale);
const related = d.guides.map((k) => guidesHere.find((g) => g.data.translationKey === k)).filter((g) => g !== undefined);
const siblings = hubsHere.filter((h) => h.id !== hub.id && (d.kind === "goal" ? h.data.kind === "goal" : h.data.group === d.group)).slice(0, 4);

const marketName = { ES: { en: "Spain", es: "España", de: "Spanien" }, DE: { en: "Germany", es: "Alemania", de: "Deutschland" } } as const;
const markets = (m: Record<string, string>) =>
	(Object.keys(m) as ("ES" | "DE")[])
		.filter((k) => k in marketName)
		.map((k) => `${marketName[k][locale]}${m[k] === "verified" ? "" : ` (${t("hub.unconfirmed")})`}`)
		.join(" · ");

const toc = [
	...(d.takeaways.length ? [{ slug: "quick", text: t("hub.quick") }] : []),
	...(d.facts.length ? [{ slug: "numbers", text: t("hub.facts") }] : []),
	...(d.checklist.length ? [{ slug: "choose", text: t("hub.choose") }] : []),
	...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
	...(rows.length ? [{ slug: "evidence", text: t("hub.evidenceH") }] : []),
	...(d.claims.length || d.notClaims.length ? [{ slug: "claims", text: t("hub.claims") }] : []),
	{ slug: "products", text: t("hub.products") },
	...(d.cautions.length ? [{ slug: "careful", text: t("hub.careful") }] : []),
	...(d.faq.length ? [{ slug: "faq", text: t("article.faq") }] : []),
	...(d.sources.length ? [{ slug: "sources", text: t("article.sources") }] : []),
];

const abs = (p: string) => new URL(p, SITE_URL).href;
const heroAlt = d.heroAlt?.trim() || d.title;
const ogImage = d.heroImage ? await socialImage(d.heroImage, heroAlt) : undefined;
const pageImages = d.heroImage ? await schemaImages(d.heroImage) : [];
const jsonLd: object[] = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: d.title,
		headline: d.title,
		description: d.description,
		inLanguage: locale,
		url: abs(url),
		datePublished: d.publishDate.toISOString(),
		dateModified: updated.toISOString(),
		about: { "@type": "Thing", name: d.name },
		...(pageImages.length ? { image: pageImages } : {}),
		author: { "@type": "Person", name: d.author, url: abs(`${path(locale, "about")}#team`) },
		publisher: { "@id": `${SITE_URL}/#org` },
		isPartOf: { "@id": `${SITE_URL}/#website` },
		...(related.length ? { hasPart: related.map((g) => ({ "@type": "Article", headline: g.data.title, url: abs(guideUrl(g)) })) } : {}),
		...(d.sources.some((s) => s.url)
			? { citation: d.sources.filter((s) => s.url).map((s) => ({ "@type": "CreativeWork", name: s.title, url: s.url })) }
			: {}),
	},
	...(d.faq.length
		? [{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				mainEntity: d.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
			}]
		: []),
];
---
<Base
	locale={locale}
	title={`${d.title} | NutriMetrics`.length <= 62 ? `${d.title} | NutriMetrics` : d.title}
	description={d.description}
	alternates={alternates}
	active="supplements"
	ogType="article"
	image={ogImage}
	breadcrumbs={[
		{ name: t("article.home"), href: path(locale) },
		{ name: t("nav.supplements"), href: path(locale, "supplements") },
		{ name: d.name, href: url },
	]}
	jsonLd={jsonLd}
>
	<div class="container">
		<nav aria-label="Breadcrumb" class="crumbs">
			<ol>
				<li><a href={path(locale)}>{t("article.home")}</a></li>
				<li><a href={path(locale, "supplements")}>{t("nav.supplements")}</a></li>
				<li aria-current="page">{d.name}</li>
			</ol>
		</nav>

		<header class="hub-head">
			<span class="eyebrow">{d.kind === "goal" ? t("group.goals") : t(`group.${d.group}` as "group.vitamins")}</span>
			<h1 class="h1" style="font-size:clamp(2rem,3.6vw,3rem)">{d.title}</h1>
			<p class="lead">{d.dek}</p>
			<div class="byline">
				<span><span class="muted">{t("article.writtenBy")}</span> <a href={`${path(locale, "about")}#team`}>{d.author}</a></span>
				<span><span class="muted">{t("hub.updated")}</span> <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated, locale)}</time></span>
				{Object.keys(alternates).length > 1 && (
					<span>
						<span class="muted">{t("article.alsoIn")}</span>
						{LOCALES.filter((l) => l !== locale && alternates[l]).map((l) => (
							<a href={alternates[l]} hreflang={l} lang={l} class="lang-pill">{l.toUpperCase()}</a>
						))}
					</span>
				)}
			</div>
		</header>

		<div class="hub-layout">
			<aside aria-labelledby="toc-h" class="toc">
				<h2 id="toc-h">{t("article.toc")}</h2>
				<ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
			</aside>

			<article class="prose">
				{d.heroImage && <HeroImage src={d.heroImage} alt={heroAlt} caption={d.heroCaption} credit={d.heroCredit} />}
				{d.takeaways.length > 0 && (
					<section id="quick" aria-labelledby="quick-h" class="quick">
						<h2 id="quick-h">{t("hub.quick")}</h2>
						<ul>{d.takeaways.map((k) => <li set:html={inlineMd(k)} />)}</ul>
					</section>
				)}

				{d.facts.length > 0 && (
					<section id="numbers" aria-labelledby="numbers-h">
						<h2 id="numbers-h">{t("hub.facts")}</h2>
						<dl class="facts">
							{d.facts.map((f) => (
								<div class="fact">
									<dt>{f.label}</dt>
									<dd class="fact-val">{f.value}</dd>
									{f.note && <dd class="fact-note">{f.note}</dd>}
								</div>
							))}
						</dl>
						<p class="gl-terms">
							<span class="muted">{t("gl.termsLabel")}</span>
							<a href={glossaryUrl(locale, "nrv")}>{t("gl.nrv")}</a>
							<a href={glossaryUrl(locale, "upper-level")}>{t("gl.upper")}</a>
							<a href={glossaryUrl(locale, "maximum-levels")}>{t("gl.max")}</a>
							<a href={glossaryUrl(locale, "daily-dose")}>{t("gl.dose")}</a>
						</p>
					</section>
				)}

				{d.checklist.length > 0 && (
					<section id="choose" aria-labelledby="choose-h">
						<h2 id="choose-h">{t("hub.choose")}</h2>
						<ol class="checklist">{d.checklist.map((c) => <li set:html={inlineMd(c)} />)}</ol>
					</section>
				)}

				<Content />

				{rows.length > 0 && (
					<section id="evidence" aria-labelledby="evidence-h">
						<h2 id="evidence-h">{t("hub.evidenceH")}</h2>
						<div class="table-wrap">
							<table class="table stack">
								<thead><tr><th scope="col">{t("hub.thIngredient")}</th><th scope="col">{t("hub.thEvidence")}</th><th scope="col">{t("hub.thClaim")}</th><th scope="col">{t("hub.thWhat")}</th></tr></thead>
								<tbody>
									{rows.map((r) => {
										const ing = ingredient(r.i);
										const h = hubForIngredient(r.i);
										return (
											<tr>
												<th scope="row">{h ? <a href={hubUrl(h)}>{ing?.[locale] ?? r.i}</a> : FINDER_TO_GLOSSARY[r.i] ? <a href={glossaryUrl(locale, FINDER_TO_GLOSSARY[r.i])} class="gl-term" title={t("gl.ingTitle")}>{ing?.[locale] ?? r.i}</a> : (ing?.[locale] ?? r.i)}</th>
												<td data-label={t("hub.thEvidence")}><span class={`ev ev-${r.ev}`}>{evidenceLabel(r.ev, locale)}</span></td>
												<td data-label={t("hub.thClaim")}>{r.claim ? t("hub.yes") : t("hub.no")}{r.cond ? ` (${t("hub.onlyDeficient")})` : ""}</td>
												<td data-label={t("hub.thWhat")}>{r[locale]}</td>
											</tr>
										);
									})}
								</tbody>
							</table>
						</div>
					</section>
				)}

				{(d.claims.length > 0 || d.notClaims.length > 0) && (
					<section id="claims" aria-labelledby="claims-h">
						<h2 id="claims-h">{t("hub.claims")}</h2>
						<div class="claims">
							{d.claims.length > 0 && (
								<div class="claim-box yes">
									<h3>{t("hub.claimsYes")}</h3>
									<ul>{d.claims.map((c) => <li set:html={inlineMd(c)} />)}</ul>
								</div>
							)}
							{d.notClaims.length > 0 && (
								<div class="claim-box no">
									<h3>{t("hub.claimsNo")}</h3>
									<ul>{d.notClaims.map((c) => <li set:html={inlineMd(c)} />)}</ul>
								</div>
							)}
						</div>
						<p class="gl-terms">
							<span class="muted">{t("gl.claimsLabel")}</span>
							<a href={glossaryUrl(locale, "health-claim")}>{t("gl.claim")}</a>
							{(d.kind === "goal" || d.group === "botanicals") && <a href={glossaryUrl(locale, "on-hold-claims")}>{t("gl.onhold")}</a>}
						</p>
					</section>
				)}

				<section id="products" aria-labelledby="products-h">
					<h2 id="products-h">{t("hub.products")}</h2>
					{rankingsHere.map((r) => (
						<a class="rank-link" href={rankingUrl(r)}>
							<span class="rank-link-k">{rankingCta}</span>
							<span class="rank-link-t">{r.data.h1} →</span>
						</a>
					))}
					{products.length > 0 ? (
						<>
							<p class="small-lead">{t("hub.productsLead")}</p>
							<div class="table-wrap">
								<table class="table products stack">
									<thead><tr><th scope="col">{t("hub.thProduct")}</th><th scope="col">{t("hub.thAmount")}</th><th scope="col">{t("hub.thMarkets")}</th><th scope="col">{t("hub.thLabel")}</th></tr></thead>
									<tbody>
										{products.map((p) => {
											const rel = p.ingredients.filter((x) => showIds.includes(x.i));
											return (
												<tr>
													<th scope="row">
														<span class="brand">{p.brand}</span> {p.name}<span class="dose">{p.dose[locale]}</span>
														{p.partial && <span class="pflag">{t("hub.partial")}</span>}
														{(p.flags ?? []).map((f) => <span class="pflag warn">{f[locale]}</span>)}
													</th>
													<td data-label={t("hub.thAmount")}>
														{rel.map((x) => {
															const ing = ingredient(x.i);
															const a = amount(x.amt, ing?.unit ?? "", locale);
															return (
																<span class="amt">
																	{rel.length > 1 || d.finderGoal || showIds.length > 1 ? <span class="amt-ing">{ing?.[locale] ?? x.i}: </span> : null}
																	{a ? <span class="mono">{a}</span> : <span class="nd">{t("hub.notDisclosed")}</span>}
																	{x.form && <span class="amt-form"> · {x.form}</span>}
																</span>
															);
														})}
													</td>
													<td data-label={t("hub.thMarkets")}>{markets(p.markets)}</td>
													<td data-label={t("hub.thLabel")}>{p.source ? <a href={p.source} rel="noopener nofollow" target="_blank">{t("hub.source")}</a> : "—"}</td>
												</tr>
											);
										})}
									</tbody>
									<caption>{t("hub.updated")}: {formatDate(new Date(checkedDate(products)), locale)}</caption>
								</table>
							</div>
						</>
					) : (
						<p class="empty">{t("hub.productsEmpty")}</p>
					)}
				</section>

				{d.cautions.length > 0 && (
					<section id="careful" aria-labelledby="careful-h" class="careful">
						<h2 id="careful-h">{t("hub.careful")}</h2>
						<ul>{d.cautions.map((c) => <li set:html={inlineMd(c)} />)}</ul>
					</section>
				)}

				<aside class="finder-cta" aria-labelledby="fcta-h">
					<div>
						<h2 id="fcta-h">{t("hub.finderH")}</h2>
						<p>{t("hub.finderP")}</p>
					</div>
					<a class="btn btn-primary" href={`${path(locale, "finder")}${d.finderGoal ? `?goal=${d.finderGoal}` : ""}`}>{t("hub.finderCta")}</a>
				</aside>

				{d.faq.length > 0 && (
					<section id="faq" aria-labelledby="faq-h">
						<h2 id="faq-h">{t("article.faq")}</h2>
						{d.faq.map((f, i) => (
							<details class="faq" open={i === 0}>
								<summary>{f.q}</summary>
								<p>{f.a}</p>
							</details>
						))}
					</section>
				)}

				{d.sources.length > 0 && (
					<section id="sources" aria-labelledby="src-h">
						<h2 id="src-h">{t("article.sources")}</h2>
						<ol class="sources">
							{d.sources.map((s) => <li>{s.url ? <a href={s.url} rel="noopener" target="_blank">{s.title}</a> : s.title}</li>)}
						</ol>
					</section>
				)}

				<p role="note" class="hub-note">{t("hub.note")}</p>
			</article>
		</div>

		{related.length > 0 && (
			<section aria-labelledby="rel-h" class="section">
				<h2 id="rel-h" class="h2">{t("hub.guides")}</h2>
				<div class="grid-auto">
					{related.map((r) => (
						<a href={guideUrl(r)} class="card rel-card">
							<span class="rel-cat">{r.data.category}</span>
							<span class="rel-title">{r.data.title}</span>
							<span class="muted" style="font-size:14px">{r.data.readingMinutes} {t("guides.read")}</span>
						</a>
					))}
				</div>
			</section>
		)}

		{siblings.length > 0 && (
			<section aria-labelledby="sib-h" class="section" style="padding-bottom:var(--nm-section-gap)">
				<div class="section-head">
					<h2 id="sib-h" class="h2">{d.kind === "goal" ? t("group.goals") : t(`group.${d.group}` as "group.vitamins")}</h2>
					<a href={path(locale, "supplements")} class="link-strong">{t("hub.all")} →</a>
				</div>
				<div class="grid-auto" style="--min:240px">
					{siblings.map((s) => (
						<a href={hubUrl(s)} class="card rel-card">
							<span class="rel-title">{s.data.name}</span>
							<span class="muted" style="font-size:14px">{s.data.description}</span>
						</a>
					))}
				</div>
			</section>
		)}
	</div>
</Base>

<style>
	.crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 20px 0 0; margin: 0; font-size: 14px; color: var(--nm-muted); }
	.crumbs li + li::before { content: "/"; margin-right: 6px; }
	.hub-head { max-width: 820px; padding: 28px 0 32px; display: flex; flex-direction: column; gap: 18px; }
	.byline { display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 14px; align-items: center; padding-top: 16px; border-top: 1px solid var(--nm-line); }
	.byline a { font-weight: 600; }
	.lang-pill { margin-left: 6px; padding: 4px 8px; border: 1px solid var(--nm-line); border-radius: var(--nm-radius-sm); text-decoration: none; font-size: 13px; }
	.hub-layout { display: grid; grid-template-columns: 240px minmax(0, 800px); gap: 56px; padding-bottom: 32px; }
	.toc { position: sticky; top: 24px; align-self: start; font-size: 14px; }
	.toc h2 { font-family: var(--nm-font-body); font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--nm-muted); margin-bottom: 10px; }
	.toc ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--nm-line); }
	.toc a { display: block; padding: 7px 14px; color: var(--nm-ink-2); text-decoration: none; }
	.toc a:hover { color: var(--nm-accent); }
	@media (max-width: 900px) {
		.hub-layout { grid-template-columns: minmax(0, 1fr); gap: 24px; }
		.toc { position: static; background: #fff; border: 1px solid var(--nm-line); border-radius: var(--nm-radius-md); padding: 16px; }
	}
	.quick { background: var(--nm-accent-soft); border-radius: var(--nm-radius-lg); padding: 24px 28px; }
	.quick h2 { margin-top: 0; font-size: 22px; }
	.quick ul { margin-top: 12px; }
	.gl-terms { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 14px; margin: 14px 0 0; }
	.facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap: 12px; margin: 16px 0 0; }
	.fact { background: #fff; border: 1px solid var(--nm-line); border-radius: var(--nm-radius-md); padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
	.fact dt { font-size: 14px; line-height: 1.4; color: var(--nm-muted); font-weight: 500; }
	.fact dd { margin: 0; }
	.fact dd.fact-val { font-size: 19px; font-weight: 600; color: var(--nm-ink); line-height: 1.3; font-variant-numeric: tabular-nums; }
	.fact-note { font-size: 13px; line-height: 1.45; color: var(--nm-ink-2); }
	.checklist { padding-left: 1.4em; }
	.checklist li::marker { font-weight: 600; color: var(--nm-accent); }
	.claims { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 14px; }
	.claim-box { border-radius: var(--nm-radius-md); padding: 18px 20px; font-size: 16px; line-height: 1.55; }
	.claim-box h3 { margin: 0 0 8px; font-size: 16px; }
	.claim-box ul { margin: 0; }
	.claim-box.yes { background: var(--nm-accent-soft); color: var(--nm-accent-ink); }
	.claim-box.no { background: #fff; border: 1px solid var(--nm-line); color: var(--nm-ink-2); }
	.small-lead { font-size: 15px; color: var(--nm-muted); line-height: 1.5; }
	.rank-link { display: flex; flex-direction: column; gap: 4px; margin: 14px 0 18px; padding: 16px 20px; background: var(--nm-accent-soft); border-radius: var(--nm-radius-md); text-decoration: none; color: var(--nm-accent-ink); }
	.rank-link:hover { box-shadow: 0 0 0 2px var(--nm-accent); color: var(--nm-accent-ink); }
	.rank-link-k { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
	.rank-link-t { font-family: var(--nm-font-display); font-size: 19px; font-weight: 600; line-height: 1.3; }
	.products th[scope="row"] { font-weight: 500; min-width: 180px; }
	.products .brand { font-weight: 600; }
	.products .dose { display: block; font-size: 13px; color: var(--nm-muted); font-weight: 400; margin-top: 2px; }
	.amt { display: block; }
	.amt + .amt { margin-top: 4px; }
	.amt-ing { color: var(--nm-ink-2); }
	.amt-form { color: var(--nm-muted); font-size: 13px; }
	.nd { color: var(--nm-muted); font-style: italic; }
	.pflag { display: block; margin-top: 6px; font-size: 13px; line-height: 1.4; font-weight: 400; color: var(--nm-ink-2); }
	.pflag.warn { color: var(--nm-deal-ink); background: var(--nm-deal-soft); padding: 4px 8px; border-radius: var(--nm-radius-sm); }
	@media (max-width: 640px) {
		.stack thead { display: none; }
		.stack, .stack tbody, .stack tr, .stack th, .stack td { display: block; width: 100%; }
		.stack tr { padding: 14px 0; border-bottom: 1px solid var(--nm-line-soft); }
		.stack tbody tr:last-child { border-bottom: 0; }
		.stack th[scope="row"], .stack td { border: 0; padding: 4px 16px; background: none; }
