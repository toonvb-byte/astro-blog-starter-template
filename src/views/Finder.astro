---
/**
 * Supplement goal finder. Sliders per goal → evidence-ranked ingredients + products in the chosen market.
 * Data: scripts/seed/finder-data.json (same source as the D1 seed). Scoring: src/lib/finder/engine.js.
 * Runs client-side; the page itself is static.
 */
import Base from "../layouts/Base.astro";
import { DEFAULT_COUNTRY, routeAlternates, type Locale } from "../i18n/config";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = {
	en: { title: "Supplement goal finder: what actually works | NutriMetrics", description: "Choose your goals (sleep, energy, stress, immunity…) and see which ingredients have real evidence and an authorised claim in the UK and EU, and at what dose.",
		eyebrow: "Supplement goal finder", h1: "Tell us what you want to improve. We'll show what actually has evidence.",
		lead: "Move the sliders. We rank ingredients by evidence and products by whether they contain those ingredients at a dose that matters. Product checks cover Spain and Germany so far; UK products are next.", market: "Shop in" },
	es: { title: "Buscador de suplementos por objetivo: lo que funciona | NutriMetrics", description: "Elige tus objetivos (sueño, energía, estrés, defensas…) y descubre qué ingredientes tienen evidencia real y qué productos de tu país los contienen en una dosis útil.",
		eyebrow: "Buscador por objetivo", h1: "Dinos qué quieres mejorar. Te mostramos lo que tiene evidencia.",
		lead: "Mueve los controles. Ordenamos los ingredientes por evidencia y los productos según si los contienen en una dosis que importa.", market: "Comprar en" },
	de: { title: "Zielfinder für Nahrungsergänzungsmittel: was wirklich wirkt", description: "Wähle deine Ziele (Schlaf, Energie, Stress, Abwehr…) und sieh, welche Wirkstoffe echte Belege haben und welche Produkte in deinem Land sie in sinnvoller Dosis enthalten.",
		eyebrow: "Zielfinder", h1: "Sag uns, was du verbessern willst. Wir zeigen, was nachweislich hilft.",
		lead: "Bewege die Regler. Wir ordnen Wirkstoffe nach Beleglage und Produkte danach, ob sie diese Wirkstoffe in einer relevanten Dosis enthalten.", market: "Einkaufen in" },
}[locale];
---
<Base locale={locale} title={copy.title} description={copy.description} alternates={routeAlternates("finder")} active="finder" disclosure={true}>
	<div class="container nmf" data-locale={locale} data-market={DEFAULT_COUNTRY[locale]}>
		<section class="nmf-intro">
			<div class="nmf-introtext">
				<span class="eyebrow">{copy.eyebrow}</span>
				<h1 class="h1">{copy.h1}</h1>
				<p class="lead">{copy.lead}</p>
			</div>
			<label class="nmf-market" for="nmf-market">
				<span>{copy.market}</span>
				<select id="nmf-market" class="input">
					<option value="ES">España</option>
					<option value="DE">Deutschland</option>
				</select>
			</label>
		</section>

		<div class="nmf-grid">
			<aside class="nmf-panel" aria-labelledby="nmf-t-panel">
				<h2 class="h3" id="nmf-t-panel"></h2>
				<div class="nmf-presets" id="nmf-presets"></div>
				<div id="nmf-goals"></div>
				<button class="nmf-reset" id="nmf-reset" type="button"></button>
			</aside>
			<div class="nmf-results">
				<div id="nmf-warns"></div>
				<section>
					<div class="nmf-sech"><h2 id="nmf-t-ing"></h2><span id="nmf-t-ingsub"></span></div>
					<div id="nmf-ings"></div>
				</section>
				<section>
					<div class="nmf-sech"><h2 id="nmf-t-prod"></h2><span id="nmf-t-prodsub"></span></div>
					<div class="nmf-cards" id="nmf-cards"></div>
				</section>
			</div>
		</div>

		<footer class="nmf-foot">
			<p id="nmf-t-disc"></p>
			<p id="nmf-t-data"></p>
		</footer>
	</div>
</Base>

<style is:global>
.nmf { padding-top: 40px; padding-bottom: 72px; }
.nmf-intro { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 28px; }
.nmf-introtext { max-width: 760px; display: flex; flex-direction: column; gap: 12px; }
.nmf-intro .h1 { font-size: clamp(1.9rem, 3.6vw, 2.8rem); text-wrap: balance; }
.nmf-market { display: flex; flex-direction: column; gap: 6px; font-size: var(--nm-small); color: var(--nm-muted); font-weight: 500; }
.nmf-market select { min-width: 180px; }
.nmf-grid { display: grid; gap: 24px; grid-template-columns: 1fr; }
@media (min-width: 920px) { .nmf-grid { grid-template-columns: 360px minmax(0, 1fr); } .nmf-panel { position: sticky; top: 16px; align-self: start; } }
.nmf-panel { background: var(--nm-surface); border: 1px solid var(--nm-line); border-radius: var(--nm-radius-lg); padding: 20px; }
.nmf-presets { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 18px; }
.nmf-presets button { border: 1px solid var(--nm-line); background: var(--nm-surface-alt); border-radius: var(--nm-pill); padding: 6px 11px; cursor: pointer; font: inherit; font-size: 13px; color: var(--nm-ink); }
.nmf-presets button:hover { border-color: var(--nm-accent); }
.nmf-goal { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; padding: 10px 0; border-top: 1px solid var(--nm-line-soft); }
.nmf-goal label { font-weight: 500; display: flex; gap: 8px; align-items: center; }
.nmf-ico { width: 22px; text-align: center; color: var(--nm-accent); font-weight: 600; }
.nmf-lvl { font: 500 12px var(--nm-font-data); color: var(--nm-muted); align-self: center; }
.nmf-lvl.on { color: var(--nm-accent-ink); background: var(--nm-accent-soft); padding: 2px 7px; border-radius: var(--nm-radius-sm); }
.nmf-gdesc { grid-column: 1 / -1; margin: 0; font-size: 13px; color: var(--nm-muted); padding-left: 30px; }
.nmf-goal input { grid-column: 1 / -1; width: 100%; accent-color: var(--nm-accent); height: 28px; margin: 0; cursor: pointer; }
.nmf-ticks { grid-column: 1 / -1; display: flex; justify-content: space-between; font-size: 11px; color: var(--nm-muted); margin-top: -4px; }
.nmf-ticks .cur { color: var(--nm-accent-ink); font-weight: 600; }
.nmf-reset { margin-top: 12px; border: 0; background: none; color: var(--nm-accent); cursor: pointer; padding: 6px 0; font: inherit; font-weight: 500; }
.nmf-results { display: grid; gap: 28px; min-width: 0; }
.nmf-sech { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 12px; }
.nmf-sech h2 { font-family: var(--nm-font-display); font-size: 22px; letter-spacing: -0.02em; margin: 0; }
.nmf-sech span { color: var(--nm-muted); font-size: 13px; }
.nmf-warn { background: var(--nm-deal-soft); color: var(--nm-deal-ink); border-radius: var(--nm-radius-md); padding: 12px 14px; font-size: 14px; }
.nmf-empty { background: var(--nm-surface); border: 1px dashed var(--nm-line); border-radius: var(--nm-radius-lg); padding: 28px; color: var(--nm-muted); text-align: center; }
.nmf-ings { background: var(--nm-surface); border: 1px solid var(--nm-line); border-radius: var(--nm-radius-lg); overflow: hidden; }
.nmf-ing { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; padding: 14px 18px; border-top: 1px solid var(--nm-line-soft); }
.nmf-ing:first-child { border-top: 0; }
.nmf-ing h3 { font-size: 16px; font-family: var(--nm-font-body); font-weight: 600; margin: 0; }
.nmf-why { grid-column: 1 / -1; color: var(--nm-ink-2); font-size: 14px; display: grid; gap: 3px; }
.nmf-why b { font-weight: 600; color: var(--nm-ink); }
.nmf-dose { font: 500 13px var(--nm-font-data); color: var(--nm-muted); text-align: right; white-space: nowrap; }
.nmf-meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; }
.nmf-pill { font-size: 12px; font-weight: 500; padding: 3px 8px; border-radius: var(--nm-radius-sm); background: var(--nm-line-soft); color: var(--nm-ink-2); }
.nmf-pill.ev3 { background: var(--nm-accent); color: #fff; }
.nmf-pill.ev2 { background: var(--nm-accent-soft); color: var(--nm-accent-ink); }
.nmf-pill.claim { border: 1px solid var(--nm-accent); background: none; color: var(--nm-accent-ink); }
.nmf-pill.flag { background: var(--nm-deal-soft); color: var(--nm-deal-ink); }
.nmf-pill.gap { background: none; border: 1px dashed var(--nm-line); color: var(--nm-muted); }
.nmf-caution { grid-column: 1 / -1; font-size: 13px; color: var(--nm-deal); }
.nmf-cards { display: grid; gap: 14px; }
.nmf-card { background: var(--nm-surface); border: 1px solid var(--nm-line); border-radius: var(--nm-radius-lg); padding: 18px; display: grid; gap: 12px; grid-template-columns: 76px minmax(0, 1fr); }
.nmf-card.top { border-color: var(--nm-accent); box-shadow: 0 0 0 1px var(--nm-accent) inset; }
.nmf-score { display: grid; justify-items: center; align-content: start; gap: 6px; }
.nmf-ring { --p: 0; width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--nm-accent) calc(var(--p) * 1%), var(--nm-line) 0); }
.nmf-ring b { width: 50px; height: 50px; border-radius: 50%; background: var(--nm-surface); display: grid; place-items: center; font: 600 16px var(--nm-font-data); }
.nmf-score small { font-size: 11px; color: var(--nm-muted); text-align: center; line-height: 1.2; }
.nmf-cbody { display: grid; gap: 10px; min-width: 0; }
.nmf-chead { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; }
.nmf-brand { font-size: 13px; color: var(--nm-muted); font-weight: 500; }
.nmf-chead h3 { font-family: var(--nm-font-display); font-size: 19px; letter-spacing: -0.01em; margin: 0; }
.nmf-price { text-align: right; font-family: var(--nm-font-data); }
.nmf-price b { font-size: 18px; font-weight: 500; }
.nmf-price small { display: block; color: var(--nm-muted); font-size: 11px; font-family: var(--nm-font-body); }
.nmf-cmeta { color: var(--nm-ink-2); font-size: 14px; }
.nmf-hits { display: grid; gap: 8px; }
.nmf-hit { display: grid; grid-template-columns: minmax(0, 1fr) 120px; gap: 4px 12px; align-items: center; font-size: 14px; }
.nmf-hit span { color: var(--nm-muted); font-family: var(--nm-font-data); font-size: 12px; }
.nmf-meter { height: 6px; border-radius: 3px; background: var(--nm-line); overflow: hidden; }
.nmf-meter i { display: block; height: 100%; background: var(--nm-accent); }
.nmf-meter.unk i { background: repeating-linear-gradient(90deg, var(--nm-muted) 0 4px, transparent 4px 8px); }
.nmf-badges { display: flex; flex-wrap: wrap; gap: 6px; }
.nmf-cfoot { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; border-top: 1px solid var(--nm-line-soft); padding-top: 12px; font-size: 13px; color: var(--nm-muted); }
.nmf-cfoot a { color: var(--nm-accent); }
.nmf-foot { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--nm-line); color: var(--nm-muted); font-size: 13px; display: grid; gap: 10px; max-width: 820px; }
@media (max-width: 520px) { .nmf-card { grid-template-columns: 1fr; } .nmf-score { grid-auto-flow: column; justify-content: start; align-items: center; } .nmf-hit { grid-template-columns: 1fr; } }
</style>

<script>
	import "../lib/finder/engine.js";
	import DATA from "../../scripts/seed/finder-data.json";

	type W = Record<string, number>;
	const root = document.querySelector<HTMLElement>(".nmf")!;
	const lang = (["es", "de"].includes(root.dataset.locale!) ? root.dataset.locale : "en") as "en" | "es" | "de";
	const NM = (window as any).NMFinder;
	const T = {
		en: { panel: "What matters to you?", reset: "Reset all", ing: "What to look for", ingSub: "Ranked for your selection",
			prod: "Products", prodSub: (m: string, n: number) => `${n} available in ${m === "ES" ? "Spain" : "Germany"}`,
			lv: ["Off", "Some", "Important", "Top"], from: "effective from", inMarket: (n: number) => (n ? `${n} product${n > 1 ? "s" : ""} here` : "No product in our database yet"),
			claim: "Authorised claim (UK & EU)", cond: "Only if deficient", match: "match", dose: "Dose", pack: "Pack",
			undisclosed: "Dose not disclosed", likely: "Availability not yet confirmed", partial: "Label partly captured",
			notDisclosed: "amount not on label", priceNote: (w: string) => `indicative · ${w}`, noPrice: "Price check coming soon",
			src: "Label source", emptyGoals: "Move at least one slider to see recommendations.", emptyProd: "No product in this market matches your selection yet.",
			disc: "Information only, not medical advice. Supplements don't replace a varied diet. Talk to a doctor or pharmacist if you are pregnant, take medication or have a health condition. Evidence ratings are NutriMetrics editorial ratings based on official sources (GB and EU claims registers, NHS, EFSA, national authorities) and systematic reviews. Products are checked for Spain and Germany; UK products are next.",
			data: (n: number, d: string) => `Database: ${n} products, label data checked ${d}. Prices are indicative.`,
			presets: [["Sleep better", { sleep: 3, stress: 1 }], ["Always tired", { energy: 3, stress: 1 }], ["Training", { muscle: 3, joints: 1 }], ["Winter defences", { immunity: 3, energy: 1 }], ["Stressed & foggy", { stress: 3, focus: 2 }]] as [string, W][] },
		es: { panel: "¿Qué te importa?", reset: "Reiniciar", ing: "Qué buscar", ingSub: "Ordenado según tu selección",
			prod: "Productos", prodSub: (m: string, n: number) => `${n} disponibles en ${m === "ES" ? "España" : "Alemania"}`,
			lv: ["No", "Algo", "Importante", "Máximo"], from: "eficaz desde", inMarket: (n: number) => (n ? `${n} producto${n > 1 ? "s" : ""} aquí` : "Aún sin producto en nuestra base"),
			claim: "Declaración autorizada UE", cond: "Solo si hay déficit", match: "encaje", dose: "Dosis", pack: "Envase",
			undisclosed: "Dosis no declarada", likely: "Disponibilidad sin confirmar", partial: "Etiqueta recogida en parte",
			notDisclosed: "cantidad no indicada", priceNote: (w: string) => `orientativo · ${w}`, noPrice: "Precio próximamente",
			src: "Fuente de la etiqueta", emptyGoals: "Mueve al menos un control para ver recomendaciones.", emptyProd: "Todavía no hay productos en este mercado para tu selección.",
			disc: "Solo información, no consejo médico. Los suplementos no sustituyen una dieta variada. Consulta a tu médico o farmacéutico si estás embarazada, tomas medicación o tienes una enfermedad. Las valoraciones de evidencia son editoriales de NutriMetrics, basadas en fuentes oficiales (registro de la UE, EFSA, autoridades nacionales) y revisiones sistemáticas.",
			data: (n: number, d: string) => `Base de datos: ${n} productos, etiquetas revisadas el ${d}. Precios orientativos.`,
			presets: [["Dormir mejor", { sleep: 3, stress: 1 }], ["Siempre cansado", { energy: 3, stress: 1 }], ["Entreno", { muscle: 3, joints: 1 }], ["Defensas invierno", { immunity: 3, energy: 1 }], ["Estrés y niebla mental", { stress: 3, focus: 2 }]] as [string, W][] },
		de: { panel: "Was ist dir wichtig?", reset: "Zurücksetzen", ing: "Worauf achten", ingSub: "Sortiert nach deiner Auswahl",
			prod: "Produkte", prodSub: (m: string, n: number) => `${n} erhältlich in ${m === "ES" ? "Spanien" : "Deutschland"}`,
			lv: ["Aus", "Etwas", "Wichtig", "Top"], from: "wirksam ab", inMarket: (n: number) => (n ? `${n} Produkt${n > 1 ? "e" : ""} hier` : "Noch kein Produkt in unserer Datenbank"),
			claim: "EU-zugelassene Angabe", cond: "Nur bei Mangel", match: "Treffer", dose: "Dosis", pack: "Packung",
			undisclosed: "Dosis nicht angegeben", likely: "Verfügbarkeit noch nicht bestätigt", partial: "Etikett teilweise erfasst",
			notDisclosed: "Menge nicht auf dem Etikett", priceNote: (w: string) => `Richtwert · ${w}`, noPrice: "Preisvergleich folgt",
			src: "Etikett-Quelle", emptyGoals: "Bewege mindestens einen Regler, um Empfehlungen zu sehen.", emptyProd: "In diesem Markt passt noch kein Produkt zu deiner Auswahl.",
			disc: "Nur zur Information, keine medizinische Beratung. Nahrungsergänzungsmittel ersetzen keine abwechslungsreiche Ernährung. Sprich mit deiner Ärztin, deinem Arzt oder in der Apotheke, wenn du schwanger bist, Medikamente nimmst oder eine Erkrankung hast. Die Bewertung der Beleglage ist eine redaktionelle Einordnung von NutriMetrics auf Basis amtlicher Quellen (EU-Register, EFSA, BfR) und systematischer Übersichtsarbeiten.",
			data: (n: number, d: string) => `Datenbank: ${n} Produkte, Etiketten geprüft am ${d}. Preise sind Richtwerte.`,
			presets: [["Besser schlafen", { sleep: 3, stress: 1 }], ["Immer müde", { energy: 3, stress: 1 }], ["Training", { muscle: 3, joints: 1 }], ["Abwehr im Winter", { immunity: 3, energy: 1 }], ["Gestresst & unkonzentriert", { stress: 3, focus: 2 }]] as [string, W][] },
	}[lang];

	const S: { market: string; w: W } = { market: root.dataset.market || "ES", w: { sleep: 3, stress: 1 } };
	try { const s = JSON.parse(localStorage.getItem("nm-finder") || "null"); if (s?.w) S.w = s.w; if (s?.market) S.market = s.market; } catch {}
	const save = () => { try { localStorage.setItem("nm-finder", JSON.stringify(S)); } catch {} };
	const $ = (id: string) => document.getElementById(id)!;
	const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
	const num = (n: number | string) => (lang === "en" ? String(n) : String(n).replace(".", ","));
	const D: any = DATA;
	const ING: Record<string, any> = Object.fromEntries(D.ingredients.map((i: any) => [i.id, i]));
	const GOAL: Record<string, any> = Object.fromEntries(D.goals.map((g: any) => [g.id, g]));
	// ?goal=sleep (linked from the goal hubs) starts with that one goal at "Top".
	try { const qg = new URLSearchParams(location.search).get("goal"); if (qg && GOAL[qg]) S.w = { [qg]: 3 }; } catch {}

	$("nmf-goals").innerHTML = D.goals.map((g: any) => `
		<div class="nmf-goal">
			<label for="nmf-g-${g.id}"><span class="nmf-ico" aria-hidden="true">${g.icon}</span>${esc(g[lang])}</label>
			<span class="nmf-lvl" id="nmf-lv-${g.id}"></span>
			<p class="nmf-gdesc" id="nmf-gd-${g.id}">${esc(g.desc[lang])}</p>
			<input type="range" id="nmf-g-${g.id}" min="0" max="3" step="1" value="0" aria-describedby="nmf-gd-${g.id}">
			<div class="nmf-ticks" aria-hidden="true" id="nmf-tk-${g.id}"></div>
		</div>`).join("");
	$("nmf-presets").innerHTML = T.presets.map(([n], i) => `<button type="button" data-p="${i}">${esc(n)}</button>`).join("");
	$("nmf-t-panel").textContent = T.panel; $("nmf-reset").textContent = T.reset;
	$("nmf-t-ing").textContent = T.ing; $("nmf-t-ingsub").textContent = T.ingSub; $("nmf-t-prod").textContent = T.prod;
	$("nmf-t-disc").textContent = T.disc;
	$("nmf-t-data").textContent = T.data(D.products.filter((p: any) => !p.excluded).length, D.meta.checked);

	function render() {
		(document.getElementById("nmf-market") as HTMLSelectElement).value = S.market;
		for (const g of D.goals) {
			const v = S.w[g.id] || 0;
			const input = $("nmf-g-" + g.id) as HTMLInputElement;
			input.value = String(v); input.setAttribute("aria-valuetext", T.lv[v]);
			const lv = $("nmf-lv-" + g.id); lv.textContent = T.lv[v]; lv.classList.toggle("on", v > 0);
			$("nmf-tk-" + g.id).innerHTML = T.lv.map((l, n) => `<span class="${n === v ? "cur" : ""}">${l}</span>`).join("");
		}
		$("nmf-warns").innerHTML = Object.keys(S.w).filter((g) => GOAL[g]?.warn).map((g) => `<div class="nmf-warn">${esc(GOAL[g].warn[lang])}</div>`).join("");
		save();
		if (!Object.keys(S.w).length) {
			$("nmf-ings").innerHTML = `<div class="nmf-empty">${T.emptyGoals}</div>`; $("nmf-cards").innerHTML = ""; $("nmf-t-prodsub").textContent = ""; return;
		}
		const r = NM.recommend(D, S.w, S.market);
		$("nmf-ings").innerHTML = `<div class="nmf-ings">${r.ingredients.slice(0, 6).map((x: any) => {
			const i = x.ingredient, best = Math.max(...x.goals.map((g: any) => g.ev));
			const anyClaim = x.goals.some((g: any) => g.claim), cond = x.goals.some((g: any) => g.cond);
			return `<div class="nmf-ing">
				<h3>${esc(i[lang])}</h3>
				<div class="nmf-dose">${T.from} ${num(i.effective)} ${i.unit}/d</div>
				<div class="nmf-why">${x.goals.sort((a: any, b: any) => b.ev - a.ev).map((g: any) => `<div><b>${esc(GOAL[g.g][lang])}:</b> ${esc(g[lang])}</div>`).join("")}${i.tip ? `<div>${esc(i.tip[lang])}</div>` : ""}</div>
				<div class="nmf-meta"><span class="nmf-pill ev${best}">${D.meta.evidenceScale[best][lang]}</span>${anyClaim ? `<span class="nmf-pill claim">${T.claim}</span>` : ""}${cond ? `<span class="nmf-pill flag">${T.cond}</span>` : ""}<span class="nmf-pill ${x.inMarket ? "" : "gap"}">${T.inMarket(x.inMarket)}</span></div>
				${i.caution ? `<div class="nmf-caution">⚠ ${esc(i.caution[lang])}</div>` : ""}
			</div>`;
		}).join("")}</div>`;
		$("nmf-t-prodsub").textContent = T.prodSub(S.market, r.products.length);
		if (!r.products.length) { $("nmf-cards").innerHTML = `<div class="nmf-empty">${T.emptyProd}</div>`; return; }
		$("nmf-cards").innerHTML = r.products.slice(0, 8).map((x: any, k: number) => {
			const p = x.p, pct = Math.round(x.match * 100);
			const hits: Record<string, any> = {};
			for (const g of Object.values<any>(x.perGoal)) for (const h of g.hits) if (!hits[h.i] || hits[h.i].value < h.value) hits[h.i] = h;
			const rows = Object.values(hits).sort((a: any, b: any) => b.value - a.value).slice(0, 5).map((h: any) => {
				const i = ING[h.i];
				const amt = h.amt == null ? `<span>${T.notDisclosed}</span>` : `<span>${num(h.amt)} ${i.unit} · ${T.from} ${num(h.eff)}</span>`;
				return `<div class="nmf-hit"><div>${esc(i[lang])} ${amt}</div><div class="nmf-meter ${h.amt == null ? "unk" : ""}"><i style="width:${Math.round(h.df * 100)}%"></i></div></div>`;
			}).join("");
			const badges = [
				x.availability === "likely" ? `<span class="nmf-pill gap">${T.likely}</span>` : "",
				x.undisclosed ? `<span class="nmf-pill flag">${T.undisclosed}</span>` : "",
				p.partial ? `<span class="nmf-pill gap">${T.partial}</span>` : "",
				p.vegan ? `<span class="nmf-pill">Vegan</span>` : "",
				...(p.flags || []).map((f: any) => `<span class="nmf-pill flag">⚠ ${esc(f[lang])}</span>`),
			].join("");
			const price = p.price ? `<b>€${num(p.price.amt.toFixed(2))}</b><small>${esc(T.priceNote(p.price.where))}</small>` : `<small>${T.noPrice}</small>`;
			return `<article class="nmf-card ${k === 0 ? "top" : ""}">
				<div class="nmf-score"><div class="nmf-ring" style="--p:${pct}"><b>${pct}</b></div><small>% ${T.match}</small></div>
				<div class="nmf-cbody">
					<div class="nmf-chead"><div><div class="nmf-brand">${esc(p.brand)}</div><h3>${esc(p.name)}</h3></div><div class="nmf-price">${price}</div></div>
					<div class="nmf-cmeta">${T.dose}: ${esc(p.dose ? p.dose[lang] : "—")} · ${T.pack}: ${esc(p.pack)}</div>
					<div class="nmf-hits">${rows}</div>
					${badges ? `<div class="nmf-badges">${badges}</div>` : ""}
					<div class="nmf-cfoot"><span>${esc(p.brand)}</span><a href="${esc(p.source)}" target="_blank" rel="noopener nofollow">${T.src} ↗</a></div>
				</div>
			</article>`;
		}).join("");
	}

	for (const g of D.goals) $("nmf-g-" + g.id).addEventListener("input", (e) => {
		const v = +(e.target as HTMLInputElement).value; if (v) S.w[g.id] = v; else delete S.w[g.id]; render();
	});
	$("nmf-presets").addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest("button"); if (!b) return; S.w = { ...T.presets[+b.dataset.p!][1] }; render(); });
	$("nmf-reset").addEventListener("click", () => { S.w = {}; render(); });
	$("nmf-market").addEventListener("change", (e) => { S.market = (e.target as HTMLSelectElement).value; render(); });
	render();
</script>
