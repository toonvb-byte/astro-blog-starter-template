---
import Base from "../layouts/Base.astro";
import { ALL_LANGUAGES, path, routeAlternates, type Locale } from "../i18n/config";
import { useT } from "../i18n/ui";
import { OPERATOR } from "../lib/site";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);

const C = {
	en: {
		title: "About NutriMetrics & our methodology",
		description: "How NutriMetrics compares supplement prices across Europe, how we make money, our editorial policy and how to contact us.",
		eyebrow: "About us",
		h1: "Supplement prices in Europe are opaque. We make them comparable.",
		lead: "Pack sizes, doses and shipping costs vary wildly between countries and shops. NutriMetrics turns every offer into one honest number — cost per dose — and puts quality information right next to it.",
		toc: ["How we compare prices", "How we make money", "Editorial policy", "Team", "Contact"],
		steps: [
			["01 · Collect", "Prices from retailer feeds", "We read product feeds from retailers and affiliate networks, and refresh them every [24] hours."],
			["02 · Match", "Same product, every shop", "Offers are matched by EAN/GTIN and checked by hand, so one product shows every place it’s sold."],
			["03 · Normalise", "Cost per dose, shipping in", "Total price to your country divided by servings, or by grams of active ingredient."],
			["04 · Qualify", "Quality signals alongside", "Form, dose, third-party testing and additives are shown with the price — never hidden behind it."],
		],
		money: ["NutriMetrics is free. Many shop links are affiliate links through networks such as AWIN and direct partner programmes: if you buy after clicking, the shop may pay us a commission. You pay the same price.", "Retailers we don’t earn from are still listed when they have the product. Every affiliate link is marked."],
		promises: ["Rankings follow price and methodology, never commission.", "No paid placements or sponsored rankings.", "Brands can’t pay to review or edit our guides."],
		editorial: ["Every guide names its author and shows when its evidence was last checked. We are not doctors, so we don’t give our own medical opinions: every health statement links to an official source — the EU register of health claims, EFSA, or a national authority such as AESAN (Spain) or BfR (Germany) — and to systematic reviews where they exist.", "We only use health claims in the wording authorised in the EU, we never claim that a supplement treats, cures or prevents a disease, and we say so when the evidence is weak. None of our guides is described as medically reviewed unless a named professional has reviewed it."],
		errors: "Spotted an error?", tell: "Tell us", errorsEnd: "— corrections are noted at the bottom of the article.",
		team: [
			["Toon Van Buylaere", "Founder & editor", "Around 20 years building and running e-commerce businesses across Europe. Started NutriMetrics because supplement prices, doses and rules differ so much between countries that comparing them honestly takes real work. Not a health professional: health statements come from the official sources linked in each guide."],
		],
		langH: "Built for all of Europe",
		langP: "Each language edition is localised for its market — local retailers, local shipping, local search terms — not just translated.",
		contactP: "Questions, corrections, or you run a shop and want to be listed? Write to us.",
		form: { name: "Name", email: "Email", topic: "Topic", message: "Message", send: "Send message", topics: ["General question", "Report an error", "Retailer / partnership", "Press"], soon: "The contact form opens at launch — email us in the meantime." },
	},
	es: {
		title: "Quiénes somos y nuestra metodología",
		description: "Cómo compara NutriMetrics los precios de suplementos en Europa, cómo ganamos dinero, nuestra política editorial y cómo contactarnos.",
		eyebrow: "Quiénes somos",
		h1: "Los precios de los suplementos en Europa son opacos. Nosotros los hacemos comparables.",
		lead: "Los tamaños de envase, las dosis y los gastos de envío cambian muchísimo entre países y tiendas. NutriMetrics convierte cada oferta en una sola cifra honesta, el coste por dosis, y pone la información de calidad justo al lado.",
		toc: ["Cómo comparamos precios", "Cómo ganamos dinero", "Política editorial", "Equipo", "Contacto"],
		steps: [
			["01 · Recopilar", "Precios de los catálogos de tiendas", "Leemos los catálogos de productos de tiendas y redes de afiliación y los actualizamos cada [24] horas."],
			["02 · Emparejar", "El mismo producto, en cada tienda", "Las ofertas se emparejan por EAN/GTIN y se revisan a mano, para que cada producto muestre todos los sitios donde se vende."],
			["03 · Normalizar", "Coste por dosis, envío incluido", "Precio total a tu país dividido entre las tomas, o entre los gramos de ingrediente activo."],
			["04 · Calificar", "Señales de calidad al lado", "Forma, dosis, análisis independientes y aditivos se muestran junto al precio, nunca escondidos."],
		],
		money: ["NutriMetrics es gratis. Muchos enlaces a tiendas son enlaces de afiliado a través de redes como AWIN y programas directos: si compras después de hacer clic, la tienda puede pagarnos una comisión. Tú pagas lo mismo.", "Las tiendas con las que no ganamos nada también aparecen si tienen el producto. Todos los enlaces de afiliado están marcados."],
		promises: ["Las clasificaciones siguen el precio y la metodología, nunca la comisión.", "Sin posiciones pagadas ni clasificaciones patrocinadas.", "Las marcas no pueden pagar para revisar o editar nuestras guías."],
		editorial: ["Cada guía indica su autor y cuándo se comprobó la evidencia por última vez. No somos médicos, así que no damos opiniones médicas propias: cada afirmación de salud enlaza a una fuente oficial —el registro de declaraciones de propiedades saludables de la UE, la EFSA o una autoridad nacional como la AESAN (España) o el BfR (Alemania)— y a revisiones sistemáticas cuando existen.", "Solo usamos declaraciones de salud con la redacción autorizada en la UE, nunca decimos que un suplemento trate, cure o prevenga una enfermedad, y lo indicamos cuando la evidencia es débil. Ninguna guía se presenta como revisada por un médico salvo que la haya revisado un profesional con nombre propio."],
		errors: "¿Has visto un error?", tell: "Dínoslo", errorsEnd: ": las correcciones se indican al final del artículo.",
		team: [
			["Toon Van Buylaere", "Fundador y editor", "Unos 20 años creando y dirigiendo negocios de comercio electrónico en Europa. Creó NutriMetrics porque los precios, las dosis y las normas de los suplementos cambian tanto entre países que compararlos con honestidad exige trabajo de verdad. No es profesional sanitario: las afirmaciones de salud proceden de las fuentes oficiales enlazadas en cada guía."],
		],
		langH: "Hecho para toda Europa",
		langP: "Cada edición está localizada para su mercado (tiendas locales, envíos locales, búsquedas locales), no solo traducida.",
		contactP: "¿Preguntas, correcciones o tienes una tienda y quieres aparecer? Escríbenos.",
		form: { name: "Nombre", email: "Email", topic: "Tema", message: "Mensaje", send: "Enviar mensaje", topics: ["Pregunta general", "Informar de un error", "Tienda / colaboración", "Prensa"], soon: "El formulario se abre en el lanzamiento; mientras tanto, escríbenos por email." },
	},
	de: {
		title: "Über NutriMetrics & unsere Methodik",
		description: "Wie NutriMetrics Preise für Nahrungsergänzungsmittel in Europa vergleicht, wie wir Geld verdienen, unsere redaktionellen Grundsätze und Kontakt.",
		eyebrow: "Über uns",
		h1: "Preise für Nahrungsergänzungsmittel in Europa sind undurchsichtig. Wir machen sie vergleichbar.",
		lead: "Packungsgrößen, Dosierungen und Versandkosten unterscheiden sich stark zwischen Ländern und Shops. NutriMetrics macht aus jedem Angebot eine ehrliche Zahl – die Kosten pro Dosis – und zeigt die Qualitätsinformationen direkt daneben.",
		toc: ["So vergleichen wir Preise", "Wie wir Geld verdienen", "Redaktionelle Grundsätze", "Team", "Kontakt"],
		steps: [
			["01 · Sammeln", "Preise aus Shop-Feeds", "Wir lesen Produkt-Feeds von Shops und Affiliate-Netzwerken und aktualisieren sie alle [24] Stunden."],
			["02 · Zuordnen", "Gleiches Produkt, jeder Shop", "Angebote werden über EAN/GTIN zugeordnet und von Hand geprüft, damit ein Produkt alle Shops zeigt, in denen es erhältlich ist."],
			["03 · Umrechnen", "Kosten pro Dosis, mit Versand", "Gesamtpreis in dein Land geteilt durch die Portionen – oder durch die Gramm Wirkstoff."],
			["04 · Einordnen", "Qualitätsmerkmale daneben", "Verbindung, Dosis, unabhängige Tests und Zusatzstoffe stehen neben dem Preis – nie dahinter versteckt."],
		],
		money: ["NutriMetrics ist kostenlos. Viele Shop-Links sind Affiliate-Links über Netzwerke wie AWIN und direkte Partnerprogramme: Wenn du nach dem Klick kaufst, zahlt uns der Shop eventuell eine Provision. Du zahlst denselben Preis.", "Shops, an denen wir nichts verdienen, werden trotzdem gelistet, wenn sie das Produkt führen. Jeder Affiliate-Link ist gekennzeichnet."],
		promises: ["Rangfolgen richten sich nach Preis und Methodik, nie nach Provision.", "Keine bezahlten Platzierungen oder gesponserten Rankings.", "Marken können nicht dafür bezahlen, unsere Ratgeber zu prüfen oder zu ändern."],
		editorial: ["Jeder Ratgeber nennt seinen Autor und zeigt, wann die Belege zuletzt geprüft wurden. Wir sind keine Ärzte und geben deshalb keine eigenen medizinischen Einschätzungen: Jede Gesundheitsaussage verweist auf eine amtliche Quelle – das EU-Register für gesundheitsbezogene Angaben, die EFSA oder eine nationale Behörde wie das BfR – und, wo vorhanden, auf systematische Übersichtsarbeiten.", "Wir verwenden gesundheitsbezogene Angaben nur im in der EU zugelassenen Wortlaut, behaupten nie, dass ein Nahrungsergänzungsmittel eine Krankheit behandelt, heilt oder verhindert, und sagen es offen, wenn die Beleglage schwach ist. Kein Ratgeber wird als medizinisch geprüft bezeichnet, solange ihn keine namentlich genannte Fachperson geprüft hat."],
		errors: "Einen Fehler entdeckt?", tell: "Schreib uns", errorsEnd: "– Korrekturen vermerken wir am Ende des Artikels.",
		team: [
			["Toon Van Buylaere", "Gründer & Redakteur", "Rund 20 Jahre Aufbau und Führung von E-Commerce-Unternehmen in Europa. Hat NutriMetrics gegründet, weil sich Preise, Dosierungen und Regeln für Nahrungsergänzungsmittel zwischen Ländern so stark unterscheiden, dass ein ehrlicher Vergleich echte Arbeit ist. Kein Arzt oder Apotheker: Gesundheitsaussagen stammen aus den amtlichen Quellen, die in jedem Ratgeber verlinkt sind."],
		],
		langH: "Gemacht für ganz Europa",
		langP: "Jede Sprachausgabe ist auf ihren Markt zugeschnitten – lokale Shops, lokaler Versand, lokale Suchbegriffe – und nicht nur übersetzt.",
		contactP: "Fragen, Korrekturen oder du betreibst einen Shop und möchtest gelistet werden? Schreib uns.",
		form: { name: "Name", email: "E-Mail", topic: "Thema", message: "Nachricht", send: "Nachricht senden", topics: ["Allgemeine Frage", "Fehler melden", "Shop / Partnerschaft", "Presse"], soon: "Das Kontaktformular öffnet zum Start – bis dahin bitte per E-Mail." },
	},
}[locale];
const ids = ["method", "money", "editorial", "team", "contact"];
---
<Base
	locale={locale}
	title={`${C.title} | NutriMetrics`.length <= 60 ? `${C.title} | NutriMetrics` : C.title}
	description={C.description}
	alternates={routeAlternates("about")}
	active="about"
	breadcrumbs={[{ name: t("article.home"), href: path(locale) }, { name: t("nav.about"), href: path(locale, "about") }]}
>
	<section aria-labelledby="about-h" style="background:#fff;border-bottom:1px solid var(--nm-line)">
		<div class="container about-hero">
			<div style="flex:999 1 560px;min-width:0;display:flex;flex-direction:column;gap:20px">
				<span class="eyebrow">{C.eyebrow}</span>
				<h1 id="about-h" class="h1">{C.h1}</h1>
				<p class="lead">{C.lead}</p>
			</div>
			<nav aria-label={t("article.toc")} class="about-toc">
				{C.toc.map((label, i) => <a href={`#${ids[i]}`}>{label}</a>)}
			</nav>
		</div>
	</section>

	<div class="container" style="display:flex;flex-direction:column;gap:72px;padding-top:64px;padding-bottom:88px">
		<section id="method" aria-labelledby="method-h" style="display:flex;flex-direction:column;gap:24px">
			<h2 id="method-h" class="h2">{C.toc[0]}</h2>
			<ol class="grid-auto steps" style="--min:240px">
				{C.steps.map(([k, h, p]) => (
					<li class="card"><span class="mono" style="font-weight:600;color:var(--nm-accent);font-size:14px">{k}</span><h3 class="h3">{h}</h3><p style="color:var(--nm-ink-2)">{p}</p></li>
				))}
			</ol>
		</section>

		<section id="money" aria-labelledby="money-h" class="dark-panel">
			<div style="flex:1 1 360px;min-width:0;display:flex;flex-direction:column;gap:16px">
				<h2 id="money-h" class="h2">{C.toc[1]}</h2>
				{C.money.map((p) => <p>{p}</p>)}
				<a href={path(locale, "disclosure")} class="btn btn-light" style="align-self:flex-start">{t("legal.disclosure")}</a>
			</div>
			<ul>
				{C.promises.map((p) => (
					<li style="display:flex;gap:12px;align-items:flex-start"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7FD1B0" stroke-width="2" aria-hidden="true" style="flex:none;margin-top:2px"><path d="M4 12l5 5L20 6"></path></svg><span style="color:#fff">{p}</span></li>
				))}
			</ul>
		</section>

		<section id="editorial" aria-labelledby="ed-h" class="two-col">
			<h2 id="ed-h" class="h2">{C.toc[2]}</h2>
			<div class="prose" style="font-size:17px">
				{C.editorial.map((p) => <p>{p}</p>)}
				<p>{C.errors} <a href="#contact">{C.tell}</a> {C.errorsEnd}</p>
			</div>
		</section>

		<section id="team" aria-labelledby="team-h" style="display:flex;flex-direction:column;gap:24px">
			<h2 id="team-h" class="h2">{C.toc[3]}</h2>
			<div class="grid-auto">
				{C.team.map(([name, role, bio], i) => (
					<div class="card person">
						<span class="avatar" aria-hidden="true" style={`background:${["#E3F1EA", "#E8ECF4"][i % 2]}`}></span>
						<strong style="font-size:18px">{name}</strong>
						<span style="color:var(--nm-accent);font-weight:600;font-size:14px">{role}</span>
						<span style="color:var(--nm-ink-2);font-size:15px">{bio}</span>
					</div>
				))}
			</div>
		</section>

		<section aria-labelledby="lang-h" class="card two-col" style="padding:32px">
			<div style="display:flex;flex-direction:column;gap:10px">
				<h2 id="lang-h" class="h2" style="font-size:28px">{C.langH}</h2>
				<p style="color:var(--nm-ink-2)">{C.langP}</p>
			</div>
			<ul class="langs">{ALL_LANGUAGES.map((l) => <li lang={l.code}>{l.name}</li>)}</ul>
		</section>

		<section id="contact" aria-labelledby="contact-h" class="two-col">
			<div style="display:flex;flex-direction:column;gap:12px">
				<h2 id="contact-h" class="h2">{C.toc[4]}</h2>
				<p style="color:var(--nm-ink-2)">{C.contactP}</p>
				<p><a href={`mailto:${OPERATOR.email}`}>{OPERATOR.email}</a><br /><span class="muted">{OPERATOR.name} · {OPERATOR.street}, {OPERATOR.postcode} {OPERATOR.city}, {OPERATOR.country[locale]}</span></p>
			</div>
			<form class="card contact-form" onsubmit="return false">
				<div class="grid-auto" style="--min:200px;gap:16px">
					<label>{C.form.name}<input class="input" type="text" autocomplete="name" disabled /></label>
					<label>{C.form.email}<input class="input" type="email" autocomplete="email" disabled /></label>
				</div>
				<label>{C.form.topic}<select class="input" disabled>{C.form.topics.map((o) => <option>{o}</option>)}</select></label>
				<label>{C.form.message}<textarea class="input" rows="5" disabled></textarea></label>
				<button type="submit" class="btn btn-primary btn-lg" style="align-self:flex-start" disabled>{C.form.send}</button>
				<p class="muted" style="font-size:13px">{C.form.soon}</p>
			</form>
		</section>
	</div>
</Base>

<style>
	.about-hero { padding-top: 64px; padding-bottom: 56px; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-end; }
	.about-toc { flex: 1 1 260px; display: flex; flex-direction: column; border-left: 2px solid var(--nm-line); }
	.about-toc a { padding: 10px 16px; min-height: 44px; display: flex; align-items: center; color: var(--nm-ink-2); text-decoration: none; font-weight: 500; }
	.about-toc a:hover { color: var(--nm-accent); }
	.steps { list-style: none; margin: 0; padding: 0; }
	.steps li { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
	.two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; align-items: start; }
	.person { padding: 24px; display: flex; flex-direction: column; gap: 6px; }
	.avatar { width: 64px; height: 64px; border-radius: 50%; margin-bottom: 8px; }
	.langs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
	.langs li { padding: 8px 14px; border: 1px solid var(--nm-line); border-radius: var(--nm-pill); font-size: 15px; }
	.contact-form { padding: 24px; display: flex; flex-direction: column; gap: 16px; }
	.contact-form label { display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 14px; }
	.contact-form textarea.input { height: auto; padding: 12px 14px; resize: vertical; }
</style>
