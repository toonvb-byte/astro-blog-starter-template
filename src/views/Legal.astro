	breadcrumbs={[{ name: t("article.home"), href: path(locale) }, { name: page.h1, href: path(locale, which) }]}
>
	<div class="container" style="padding-top:56px;padding-bottom:88px">
		<article class="prose" style="max-width:760px">
			<h1 class="h1" style="font-size:clamp(2rem,3.4vw,2.8rem)">{page.h1}</h1>
			<p class="muted" style="font-size:14px">{C.updated}: <time datetime={UPDATED}>{dateLabel}</time></p>
			{page.intro && <p>{page.intro}</p>}
			{page.body.map(([h, p]) => (
				<>
					<h2>{h}</h2>
					<p set:html={p} />
				</>
			))}
			{which === "privacy" && <p class="muted" style="font-size:14px">→ <a href={cookieLink}>{t("legal.cookies")}</a></p>}
			{which === "cookies" && <p class="muted" style="font-size:14px">→ <a href={privacyLink}>{t("legal.privacy")}</a></p>}
		</article>
	</div>
</Base>

<style>
	:global(.link-btn) { background: none; border: 0; padding: 0; font: inherit; color: var(--nm-accent); text-decoration: underline; cursor: pointer; }
</style>
