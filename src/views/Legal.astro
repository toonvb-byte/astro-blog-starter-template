---
/**
 * Legal pages: Aviso legal / Impressum / Imprint, privacy, cookies, affiliate disclosure.
 * Operator details, GA and affiliate switches live in src/lib/site.ts — the texts adapt to them.
 * Written to the usual Spanish (LSSI, RGPD/LOPDGDD) and German (DDG, MStV, DSGVO, TDDDG) requirements;
 * the English texts also cover UK GDPR, PECR and the ASA/CAP rules for UK readers.
 * Not legal advice: have them checked once by a gestor or lawyer.
 */
import Base from "../layouts/Base.astro";
import { path, routeAlternates, type Locale } from "../i18n/config";
import { useT } from "../i18n/ui";
import { AFFILIATE, GA_ENABLED, OPERATOR as O, SITE_URL } from "../lib/site";

type Which = "privacy" | "cookies" | "imprint" | "disclosure";
interface Props { locale: Locale; which: Which }
const { locale, which } = Astro.props;
const t = useT(locale);

const UPDATED = locale === "en" ? "2026-10-30" : "2026-10-19";
const mail = (e: string) => `<a href="mailto:${e}">${e}</a>`;
const addr = `${O.street}, ${O.postcode} ${O.city}, ${O.country[locale]}`;
const networks = [AFFILIATE.awin && "AWIN", AFFILIATE.amazon && "Amazon"].filter(Boolean) as string[];
const anyNetwork = networks.length > 0;
const list = (xs: string[], and: string) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} ${and} ${xs.at(-1)}`);
const cookieLink = path(locale, "cookies");
const privacyLink = path(locale, "privacy");
const settingsBtn = (label: string) => (GA_ENABLED ? ` <button type="button" class="link-btn" data-consent-open>${label}</button>` : "");

type Section = [string, string];
type Page = { h1: string; intro?: string; body: Section[] };

const L: Record<Locale, { updated: string } & Record<Which, Page>> = {
	es: {
		updated: "Última actualización",
		imprint: {
			h1: "Aviso legal",
			intro: "En cumplimiento del artículo 10 de la Ley 34/2002, de servicios de la sociedad de la información y de comercio electrónico (LSSI-CE), se facilitan los siguientes datos.",
			body: [
				["Titular del sitio web", `${O.name}<br />NIE: ${O.taxId}<br />Domicilio: ${addr}<br />Correo electrónico: ${mail(O.email)}`],
