---
/** "In the news": news items that list this hub or guide as related (same language). Renders nothing if there are none. */
import { path, type Locale } from "../i18n/config";
import { useT, formatDate } from "../i18n/ui";
import { newsUrl, type NewsItem } from "../lib/news";
import { REGION_LABEL } from "../lib/news-meta";

interface Props { locale: Locale; items: NewsItem[] }
const { locale, items } = Astro.props;
const t = useT(locale);
---
{items.length > 0 && (
	<section aria-labelledby="inews-h" class="section inews">
		<div class="section-head">
			<h2 id="inews-h" class="h2">{t("news.inTheNews")}</h2>
			<a href={path(locale, "news")} class="link-strong">{t("home.newsAll")}</a>
		</div>
		<ul class="inews-list">
			{items.map((n) => (
				<li>
					<span class="inews-meta"><time datetime={n.data.eventDate.toISOString().slice(0, 10)}>{formatDate(n.data.eventDate, locale)}</time> · <strong>{n.data.place?.trim() || REGION_LABEL[locale][n.data.region]}</strong></span>
					<a href={newsUrl(n)}>{n.data.title}</a>
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.inews-list { list-style: none; margin: 0; padding: 0; max-width: 820px; }
	.inews-list li { display: flex; flex-direction: column; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--nm-line-soft); }
	.inews-list a { font-weight: 600; font-size: 18px; text-decoration: none; line-height: 1.3; }
	.inews-list a:hover { text-decoration: underline; }
	.inews-meta { font-size: 13px; color: var(--nm-muted); }
	.inews-meta strong { color: var(--nm-accent-ink); font-weight: 600; }
</style>
