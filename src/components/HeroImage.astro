---
/** Hero image for guides and supplement pages: responsive AVIF/WebP, loaded first (it is usually the largest element). */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { HERO_SIZES, HERO_WIDTHS } from "../lib/images";

interface Props { src: ImageMetadata; alt: string; caption?: string | null; credit?: string | null }
const { src, alt, caption, credit } = Astro.props;
const note = [caption, credit].filter(Boolean).join(" · ");
const fit = HERO_WIDTHS.filter((w) => w <= src.width);
const widths = fit.length ? fit : [src.width];
---
<figure class="hero-img">
	<Picture
		src={src}
		alt={alt}
		formats={["avif", "webp"]}
		widths={widths}
		sizes={HERO_SIZES}
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>
	{note && <figcaption>{note}</figcaption>}
</figure>

<style>
	.hero-img { margin: 0 0 28px; }
	.hero-img :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--nm-radius-lg); background: var(--nm-accent-soft); }
	.hero-img figcaption { margin-top: 8px; font-size: 13px; line-height: 1.45; color: var(--nm-muted); }
</style>
