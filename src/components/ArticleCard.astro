---
import CardArt from "./CardArt.astro";
interface Props {
	href: string;
	category: string;
	title: string;
	dek?: string;
	meta: string;
	imageLabel: string;
	tint?: string;
}
const { href, category, title, dek, meta, tint = "var(--nm-accent-soft)" } = Astro.props;
---
<article class="article-card" data-search={`${title} ${dek ?? ""} ${category}`.toLowerCase()}>
	<CardArt tint={tint} />
	<span class="cat">{category}</span>
	<h3><a href={href}>{title}</a></h3>
	{dek && <p class="dek">{dek}</p>}
	<span class="meta">{meta}</span>
</article>
