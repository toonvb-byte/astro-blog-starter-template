---
import { ALL_LANGUAGES, LOCALES, path, rankingsIndexPath, type Locale } from "../i18n/config";
import { useT } from "../i18n/ui";
import { AMAZON_MARKET_BY_LOCALE, AMAZON_STATEMENT, GA_ENABLED, amazonLive } from "../lib/site";

interface Props { locale: Locale; alternates: Partial<Record<Locale, string>> }
const { locale, alternates } = Astro.props;
const t = useT(locale);
const about = path(locale, "about");
const guides = path(locale, "guides");
const year = new Date().getFullYear();
const rankingsIndex = rankingsIndexPath(locale);
const langName = (c: string) => ALL_LANGUAGES.find((l) => l.code === c)?.name ?? c;
// Amazon's required sentence on every page of a language whose shop links go to a tagged Amazon store
const amazonLine = amazonLive(AMAZON_MARKET_BY_LOCALE[locale]) ? AMAZON_STATEMENT[locale] : "";
---
<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<span class="logo-word">NutriMetrics<span>.eu</span></span>
				<p>{t("footer.about")}</p>
				{amazonLine && <p style="font-size:13px">{amazonLine}</p>}
				<p style="font-size:13px">{t("footer.medical")}</p>
			</div>
			<nav aria-label={t("footer.tools")} class="footer-col">
				<span class="head">{t("footer.tools")}</span>
				<a href={path(locale, "finder")}>{t("nav.finder")}</a>
				{rankingsIndex && <a href={rankingsIndex}>{t("rankings.all")}</a>}
				<a href={path(locale, "glossary")}>{t("footer.glossary")}</a>
			</nav>
			<nav aria-label={t("footer.guidesHead")} class="footer-col">
				<span class="head">{t("footer.guidesHead")}</span>
				<a href={path(locale, "supplements")}>{t("footer.supplements")}</a>
				<a href={guides}>{t("footer.buying")}</a>
				<a href={path(locale, "news")}>{t("footer.news")}</a>
			</nav>
			<nav aria-label={t("footer.company")} class="footer-col">
				<span class="head">{t("footer.company")}</span>
				<a href={about}>{t("footer.aboutUs")}</a>
				<a href={`${about}#method`}>{t("footer.methodology")}</a>
				<a href={`${about}#money`}>{t("footer.money")}</a>
				<a href={`${about}#contact`}>{t("footer.contact")}</a>
			</nav>
		</div>
		<nav aria-label={t("footer.readIn")} class="footer-langs">
			<span class="label">{t("footer.readIn")}</span>
			{LOCALES.map((l) => (
				<a href={alternates[l] ?? path(l)} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined}>{langName(l)}</a>
			))}
		</nav>
		<div class="footer-bottom">
			<span>© {year} NutriMetrics.eu</span>
			<nav aria-label="Legal">
				<a href={path(locale, "disclosure")}>{t("legal.disclosure")}</a>
				<a href={path(locale, "privacy")}>{t("legal.privacy")}</a>
				<a href={path(locale, "cookies")}>{t("legal.cookies")}</a>
				<a href={path(locale, "imprint")}>{t("legal.imprint")}</a>
				{GA_ENABLED && <a href={path(locale, "cookies")} data-consent-open>{t("legal.cookieSettings")}</a>}
			</nav>
		</div>
	</div>
</footer>
